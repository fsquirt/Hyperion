<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SignAssembly>true</SignAssembly>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Update="..\ico.jpg">
      <Link>ico.jpg</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />
  </ItemGroup>

  <Target Name="CopyNativeDll" AfterTargets="Build">
    <PropertyGroup>
      <NativeBase>$(MSBuildThisFileDirectory)..\</NativeBase>
      <TargetNativeDll>$(NativeBase)CombinationNative\x64\$(Configuration)\CombinationNative.dll</TargetNativeDll>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetNativeDll)"
          DestinationFolder="$(OutDir)"
          Condition="Exists('$(TargetNativeDll)')"
          SkipUnchangedFiles="true" />
    <Warning Text="CombinationNative.dll ($(Configuration) 版) 未找到！请先构建 CombinationNative 项目的 x64 $(Configuration) 配置。当前尝试路径: $(TargetNativeDll)"
             Condition="!Exists('$(TargetNativeDll)')" />
  </Target>

</Project>
