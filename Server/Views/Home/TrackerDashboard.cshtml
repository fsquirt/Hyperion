<div class="p-4">
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card stat-card"><div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div><h6 class="card-subtitle mb-1 text-muted">活跃会话</h6><h2 class="card-title mb-0" id="activeCount">-</h2></div>
                    <i class="bi bi-broadcast display-6 text-muted"></i>
                </div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card"><div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div><h6 class="card-subtitle mb-1 text-muted">已结束</h6><h2 class="card-title mb-0" id="finishedCount">-</h2></div>
                    <i class="bi bi-check-circle display-6 text-muted"></i>
                </div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card"><div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div><h6 class="card-subtitle mb-1 text-muted">总事件数</h6><h2 class="card-title mb-0" id="totalEvents">-</h2></div>
                    <i class="bi bi-list-ul display-6 text-muted"></i>
                </div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card"><div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div><h6 class="card-subtitle mb-1 text-muted">最近活动</h6><h6 class="card-title mb-0" id="lastActivity" style="font-size:0.85rem">-</h6></div>
                    <i class="bi bi-clock display-6 text-muted"></i>
                </div>
            </div></div>
        </div>
    </div>

    <div class="row g-3" style="min-height: 500px;">
        <!-- 左侧：会话列表 -->
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-hdd-rack me-2"></i>会话列表</span>
                    <button class="btn btn-outline-dark btn-sm" onclick="loadSessions()"><i class="bi bi-arrow-clockwise"></i></button>
                </div>
                <div class="card-body p-0" style="overflow-y:auto; max-height:600px;">
                    <div id="sessionList" class="list-group list-group-flush">
                        <div class="text-center text-muted py-4">加载中...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 右侧：事件详情 -->
        <div class="col-md-8">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span id="detailTitle"><i class="bi bi-activity me-2"></i>事件详情</span>
                    <span id="detailMeta" class="text-muted small"></span>
                </div>
                <!-- 过滤栏 -->
                <div id="filterBar" class="border-bottom px-3 py-2 d-none" style="background:#fafafa;">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="btn-group btn-group-sm" id="levelFilter">
                            <button class="btn btn-outline-secondary active" data-level="" onclick="setLevelFilter(this)">全部</button>
                            <button class="btn btn-outline-danger" data-level="HIGH" onclick="setLevelFilter(this)">HIGH</button>
                            <button class="btn btn-outline-warning" data-level="WARN" onclick="setLevelFilter(this)">WARN</button>
                            <button class="btn btn-outline-primary" data-level="INFO" onclick="setLevelFilter(this)">INFO</button>
                        </div>
                        <div class="input-group input-group-sm" style="max-width:260px;">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" id="eventSearch" class="form-control" placeholder="搜索事件..." oninput="onSearchInput()">
                            <button class="btn btn-outline-secondary" onclick="clearSearch()" title="清除"><i class="bi bi-x-lg"></i></button>
                        </div>
                        <span id="filterCount" class="text-muted small ms-auto"></span>
                    </div>
                </div>
                <div class="card-body p-0" style="overflow-y:auto; max-height:600px;">
                    <div id="eventDetail">
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-cursor display-4 d-block mb-3"></i>
                            选择左侧会话查看事件
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.session-item {
    cursor: pointer;
    transition: background 0.15s;
    border-left: 3px solid transparent;
}
.session-item:hover { background: rgba(0,0,0,0.02); }
.session-item.active {
    background: rgba(13,110,253,0.04);
    border-left-color: #0d6efd;
}
.session-item .session-status {
    width: 8px; height: 8px;
    border-radius: 50%;
    display: inline-block;
    margin-right: 6px;
}
.session-item .session-status.active { background: #16a34a; }
.session-item .session-status.finished { background: #999; }

.event-row {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid #f0f0f0;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.1s;
}
.event-row:hover { background: rgba(0,0,0,0.02); }
.event-row .event-time {
    color: #999;
    font-family: monospace;
    font-size: 0.8rem;
    white-space: nowrap;
    min-width: 100px;
}
.event-row .event-level {
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.5px;
    min-width: 50px;
    text-align: center;
    padding: 1px 6px;
    border-radius: 2px;
}
.event-level.CRIT  { background: rgba(220,38,38,0.1); color: #dc2626; }
.event-level.HIGH  { background: rgba(220,38,38,0.1); color: #dc2626; }
.event-level.WARN  { background: rgba(217,119,6,0.1);  color: #d97706; }
.event-level.INFO  { background: rgba(59,130,246,0.08); color: #3b82f6; }
.event-level.DEBUG { background: rgba(107,114,128,0.08); color: #6b7280; }

.event-row .event-title { font-weight: 500; color: #1a1a1a; }
.event-row .event-source { color: #666; font-size: 0.8rem; }

.event-detail-panel {
    padding: 0.75rem 1rem;
    background: #f8f9fa;
    border-bottom: 1px solid #e0e0e0;
    font-size: 0.82rem;
    display: none;
}
.event-detail-panel.open { display: block; }
.event-detail-panel pre {
    margin: 0;
    font-size: 0.8rem;
    white-space: pre-wrap;
    word-break: break-all;
    color: #333;
}

.no-events {
    text-align: center;
    padding: 3rem;
    color: #999;
}
</style>

<script src="/js/tracker-dashboard.js"></script>
