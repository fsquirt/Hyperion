@{
    var title = ViewBag.PlaceholderTitle as string ?? "待实现";
    var desc = ViewBag.PlaceholderDesc as string ?? "此功能尚未实现,占位等待后续开发。";
    var icon = ViewBag.PlaceholderIcon as string ?? "bi-hourglass-split";
    var category = ViewBag.PlaceholderCategory as string ?? "";
}

<div class="p-5">
    <div class="card mx-auto" style="max-width: 720px;">
        <div class="card-body p-5 text-center">
            <div class="mb-4">
                <i class="bi @icon display-1 text-muted opacity-50"></i>
            </div>
            <h4 class="mb-3">@title</h4>
            <p class="text-muted mb-1">@desc</p>
            @if (!string.IsNullOrEmpty(category))
            {
                <p class="text-muted small mb-0">
                    <span class="badge bg-secondary">@category</span>
                    <span class="ms-2">位置已预留,功能待开发</span>
                </p>
            }
            else
            {
                <p class="text-muted small mb-0">位置已预留,功能待开发</p>
            }
        </div>
    </div>
</div>
