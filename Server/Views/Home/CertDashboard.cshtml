<div class="p-4">
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabCertHistory"><i class="bi bi-clock-history me-1"></i>校验历史</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabCertBrowse"><i class="bi bi-table me-1"></i>证书浏览</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabCertManage"><i class="bi bi-gear me-1"></i>证书管理</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabCertAdd"><i class="bi bi-plus-circle me-1"></i>手动添加</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabCertParse"><i class="bi bi-upload me-1"></i>上传解析</button></li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="tabCertHistory">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-clock-history me-2"></i>证书校验历史</span>
                    <div class="d-flex align-items-center gap-2">
                        <div class="input-group input-group-sm" style="width:260px">
                            <input type="text" class="form-control" id="certHistorySearch" placeholder="搜索 ID / 时间 / 结果..." onkeydown="if(event.key==='Enter')filterCertHistory()">
                            <button class="btn btn-outline-secondary" onclick="filterCertHistory()"><i class="bi bi-search"></i></button>
                        </div>
                        <button class="btn btn-outline-dark btn-sm" onclick="loadCertHistory()"><i class="bi bi-arrow-clockwise"></i> 刷新</button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead><tr><th>时间</th><th>ID</th><th>客户端证书数</th><th>信任列表数</th><th>可疑数</th><th>结果</th></tr></thead>
                            <tbody id="certHistoryTable"><tr><td colspan="6" class="text-center text-muted py-4">加载中...</td></tr></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="tabCertBrowse">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div id="certCsvMeta" class="text-muted small"></div>
                <div class="d-flex gap-2">
                    <input type="text" class="form-control form-control-sm" style="width:250px" id="certSearch" placeholder="搜索 Subject / Owner / CN..." onkeyup="filterCertTable()">
                    <button class="btn btn-success btn-sm" onclick="showAddCertModal()"><i class="bi bi-plus-circle me-1"></i>添加</button>
                </div>
            </div>
            <div class="card">
                <div class="card-body p-0" style="max-height:70vh;overflow:auto">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="sticky-top bg-white"><tr><th>Status</th><th>CA Owner</th><th>Common Name</th><th>Subject</th><th>SHA-1</th><th>SHA-256</th><th style="width:90px">操作</th></tr></thead>
                            <tbody id="certCsvBody"><tr><td colspan="7" class="text-center text-muted py-4">加载中...</td></tr></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="tabCertManage">
            <div class="row g-3">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header">CSV 文件信息</div>
                        <div class="card-body" id="certManageInfo">加载中...</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header">同步更新</div>
                        <div class="card-body">
                            <p class="text-muted small">从 Microsoft 受信任根证书项目同步最新 CSV。</p>
                            <button class="btn btn-primary w-100" id="syncBtn" onclick="syncCertCsv()"><i class="bi bi-cloud-download me-1"></i>一键同步</button>
                            <div id="syncResult" class="mt-3"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── 手动添加 ── -->
        <div class="tab-pane fade" id="tabCertAdd">
            <div class="card" style="max-width:720px">
                <div class="card-header"><i class="bi bi-plus-circle me-2"></i>手动输入证书信息</div>
                <div class="card-body">
                    <p class="text-muted small">直接填写证书字段添加到受信任白名单。SHA-256 必填，为 64 位十六进制；SHA-1 选填，为 40 位十六进制。</p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Microsoft Status</label>
                            <input type="text" class="form-control" id="certAddStatus" value="Manual" placeholder="如:Manual">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">CA Owner</label>
                            <input type="text" class="form-control" id="certAddCaOwner" placeholder="如:Microsoft">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Common Name (CN)</label>
                            <input type="text" class="form-control" id="certAddCommonName" placeholder="如:Microsoft Root CA">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Subject · 完整 DN</label>
                            <input type="text" class="form-control" id="certAddSubject" placeholder='如:CN=Microsoft Root CA, O=Microsoft...'>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">SHA-1 · 40 位，可选</label>
                            <input type="text" class="form-control font-monospace" id="certAddSha1" placeholder="40 位十六进制">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">SHA-256 · 64 位，必填</label>
                            <input type="text" class="form-control font-monospace" id="certAddSha256" placeholder="64 位十六进制">
                        </div>
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-success btn-sm" id="certAddBtn" onclick="submitCertAddForm()">
                            <i class="bi bi-plus-circle me-1"></i>添加到白名单
                        </button>
                        <div id="certAddResult" class="mt-3"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── 上传解析 ── -->
        <div class="tab-pane fade" id="tabCertParse">
            <div class="card" style="max-width:720px">
                <div class="card-header"><i class="bi bi-upload me-2"></i>上传证书文件解析</div>
                <div class="card-body">
                    <p class="text-muted small">上传 .cer/.crt/.pem 证书文件,自动解析出 Subject / Issuer / SHA-1 / SHA-256 等信息,确认后添加到白名单。</p>
                    <div class="mb-3">
                        <label class="form-label">证书文件</label>
                        <input type="file" class="form-control" id="certParseFile" accept=".cer,.crt,.pem,.der,.p7b">
                    </div>
                    <button class="btn btn-primary btn-sm" id="certParseBtn" onclick="parseCertFile()">
                        <i class="bi bi-search me-1"></i>解析证书
                    </button>
                    <div id="certParseResult" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="certDetailModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">证书校验详情</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body" id="certDetailBody"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="syncConfirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">确认同步</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body" id="syncConfirmBody"></div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button class="btn btn-primary" id="syncConfirmBtn">确认替换</button>
            </div>
        </div>
    </div>
</div>

<!-- ── 添加/编辑证书模态框 ── -->
<div class="modal fade" id="certModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="certModalTitle">手动添加证书</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Microsoft Status</label>
                        <input type="text" class="form-control" id="certModalStatus" value="Manual">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">CA Owner</label>
                        <input type="text" class="form-control" id="certModalCaOwner">
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Common Name (CN)</label>
                        <input type="text" class="form-control" id="certModalCommonName">
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Subject · 完整 DN</label>
                        <input type="text" class="form-control" id="certModalSubject">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">SHA-1 · 40 位，可选</label>
                        <input type="text" class="form-control font-monospace" id="certModalSha1">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">SHA-256 · 64 位，必填</label>
                        <input type="text" class="form-control font-monospace" id="certModalSha256">
                    </div>
                </div>
                <div id="certModalResult" class="mt-3"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="certModalSubmitBtn" onclick="submitCertModal()">添加</button>
            </div>
        </div>
    </div>
</div>

<script src="/js/cert-dashboard.js" asp-append-version="true"></script>
