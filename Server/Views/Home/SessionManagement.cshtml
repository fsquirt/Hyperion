<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-hdd-rack me-2"></i>会话管理</h4>
        <button class="btn btn-outline-dark btn-sm" onclick="smLoadSessions()">
            <i class="bi bi-arrow-clockwise me-1"></i>刷新
        </button>
    </div>

    <div class="row g-3" style="min-height: 500px;">
        <!-- 左侧:会话列表 -->
        <div class="col-md-5">
            <div class="card h-100">
                <div class="card-header py-2">
                    <span class="small text-muted">所有会话</span>
                </div>
                <div class="card-body p-0" style="overflow-y:auto; max-height:600px;">
                    <div id="smSessionList" class="list-group list-group-flush">
                        <div class="text-center text-muted py-4">加载中...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 右侧:会话详情 -->
        <div class="col-md-7">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center py-2">
                    <span id="smDetailTitle" class="small text-muted">选择会话查看详情</span>
                    <div id="smActions" class="d-none">
                        <button class="btn btn-outline-warning btn-sm me-1" id="smEndBtn" onclick="smEndSession()">
                            <i class="bi bi-stop-circle me-1"></i>结束
                        </button>
                        <button class="btn btn-outline-danger btn-sm" onclick="smDeleteSession()">
                            <i class="bi bi-trash me-1"></i>删除
                        </button>
                    </div>
                </div>
                <div class="card-body p-3" style="overflow-y:auto; max-height:600px;">
                    <div id="smDetail">
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-cursor display-4 d-block mb-3"></i>
                            选择左侧会话查看详情
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.sm-session-item {
    cursor: pointer;
    transition: background 0.15s;
    border-left: 3px solid transparent;
}
.sm-session-item:hover { background: rgba(0,0,0,0.02); }
.sm-session-item.active {
    background: rgba(13,110,253,0.04);
    border-left-color: #0d6efd;
}
.sm-session-item .session-status {
    width: 8px; height: 8px;
    border-radius: 50%;
    display: inline-block;
    margin-right: 6px;
}
.sm-session-item .session-status.active { background: #16a34a; }
.sm-session-item .session-status.finished { background: #999; }

.sm-detail-row {
    display: flex;
    padding: 0.4rem 0;
    border-bottom: 1px solid #f0f0f0;
    font-size: 0.85rem;
}
.sm-detail-row:last-child { border-bottom: none; }
.sm-detail-label {
    width: 120px;
    color: #666;
    flex-shrink: 0;
}
.sm-detail-value {
    color: #1a1a1a;
    word-break: break-all;
}
</style>

<script src="/js/session-list.js" asp-append-version="true"></script>
<script src="/js/session-management.js" asp-append-version="true"></script>
