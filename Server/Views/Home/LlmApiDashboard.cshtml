<div class="p-4">
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabLlmList"><i class="bi bi-cloud me-1"></i>API 列表</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabLlmAdd"><i class="bi bi-plus-circle me-1"></i>添加 API</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabCredList"><i class="bi bi-key me-1"></i>访问凭据</button></li>
    </ul>

    <div class="tab-content">
        <!-- ── API 列表 ── -->
        <div class="tab-pane fade show active" id="tabLlmList">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span>
                        <i class="bi bi-cloud me-2"></i>大模型 API
                        <span class="badge bg-primary ms-2" id="llmStatTotal">-</span>
                        <span class="text-muted small ms-2">
                            (启用:<span id="llmStatEnabled">-</span>
                            / 禁用:<span id="llmStatDisabled">-</span>)
                        </span>
                    </span>
                    <div class="d-flex align-items-center gap-2">
                        <select class="form-select form-select-sm" id="llmProviderFilter" style="width:130px" onchange="loadLlmList()">
                            <option value="">全部提供商</option>
                            <option value="openai">OpenAI</option>
                            <option value="anthropic">Anthropic</option>
                            <option value="deepseek">DeepSeek</option>
                            <option value="qwen">通义千问</option>
                            <option value="custom">自定义</option>
                        </select>
                        <select class="form-select form-select-sm" id="llmEnabledFilter" style="width:110px" onchange="loadLlmList()">
                            <option value="">全部状态</option>
                            <option value="true">启用</option>
                            <option value="false">禁用</option>
                        </select>
                        <div class="input-group input-group-sm" style="width:240px">
                            <input type="text" class="form-control" id="llmSearch" placeholder="搜索名称/模型/URL..." onkeydown="if(event.key==='Enter')loadLlmList()">
                            <button class="btn btn-outline-secondary" onclick="loadLlmList()"><i class="bi bi-search"></i></button>
                        </div>
                        <button class="btn btn-outline-dark btn-sm" onclick="loadLlmList()"><i class="bi bi-arrow-clockwise"></i></button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height:65vh;overflow:auto">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="sticky-top bg-white">
                                <tr><th>名称</th><th>提供商</th><th>模型</th><th>Base URL</th><th>API Key</th><th>优先级</th><th>状态</th><th>操作</th></tr>
                            </thead>
                            <tbody id="llmTableBody"><tr><td colspan="8" class="text-center text-muted py-4">加载中...</td></tr></tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <span class="text-muted small" id="llmPageInfo">-</span>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary" id="llmPrev" onclick="llmChangePage(-1)"><i class="bi bi-chevron-left"></i></button>
                        <button class="btn btn-outline-secondary" id="llmNext" onclick="llmChangePage(1)"><i class="bi bi-chevron-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── 添加 API ── -->
        <div class="tab-pane fade" id="tabLlmAdd">
            <div class="card" style="max-width:680px">
                <div class="card-header"><i class="bi bi-plus-circle me-2"></i>添加大模型 API</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">名称 *</label>
                        <input type="text" class="form-control" id="llmAddName" placeholder="如:GPT-4o 生产环境">
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">提供商</label>
                            <select class="form-select" id="llmAddProvider">
                                <option value="openai">OpenAI</option>
                                <option value="anthropic">Anthropic</option>
                                <option value="deepseek">DeepSeek</option>
                                <option value="qwen">通义千问</option>
                                <option value="custom" selected>自定义</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">模型名 *</label>
                            <input type="text" class="form-control font-monospace" id="llmAddModel" placeholder="如:gpt-4o / claude-3-opus / deepseek-chat">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Base URL *</label>
                        <input type="text" class="form-control font-monospace" id="llmAddUrl" placeholder="如:https://api.openai.com/v1">
                        <div class="form-text">API 端点,不含 /chat/completions 后缀。</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">API Key *</label>
                        <input type="text" class="form-control font-monospace" id="llmAddKey" placeholder="sk-...">
                        <div class="form-text">存储后列表展示会脱敏,集群获取时返回完整。</div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">优先级</label>
                            <input type="number" class="form-control" id="llmAddPriority" value="100" min="0">
                            <div class="form-text">数字越小越优先。</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Max Tokens</label>
                            <input type="number" class="form-control" id="llmAddMaxTokens" value="4096" min="1">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Temperature</label>
                            <input type="number" class="form-control" id="llmAddTemp" value="0.7" min="0" max="2" step="0.1">
                        </div>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="llmAddEnabled" checked>
                        <label class="form-check-label" for="llmAddEnabled">启用</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">备注 (可选)</label>
                        <input type="text" class="form-control" id="llmAddNotes" placeholder="如:生产环境主用">
                    </div>
                    <button class="btn btn-success btn-sm" onclick="addLlmApi()">
                        <i class="bi bi-plus-circle me-1"></i>添加
                    </button>
                    <div id="llmAddResult" class="mt-3"></div>
                </div>
            </div>
        </div>

        <!-- ── 访问凭据 ── -->
        <div class="tab-pane fade" id="tabCredList">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span>
                        <i class="bi bi-key me-2"></i>访问凭据
                        <span class="badge bg-success ms-2" id="credStatTotal">-</span>
                        <span class="text-muted small ms-2">
                            (启用:<span id="credStatEnabled">-</span>
                            / 禁用:<span id="credStatDisabled">-</span>)
                        </span>
                    </span>
                    <div class="d-flex align-items-center gap-2">
                        <select class="form-select form-select-sm" id="credEnabledFilter" style="width:110px" onchange="loadCredList()">
                            <option value="">全部状态</option>
                            <option value="true">启用</option>
                            <option value="false">禁用</option>
                        </select>
                        <div class="input-group input-group-sm" style="width:220px">
                            <input type="text" class="form-control" id="credSearch" placeholder="搜索凭据名..." onkeydown="if(event.key==='Enter')loadCredList()">
                            <button class="btn btn-outline-secondary" onclick="loadCredList()"><i class="bi bi-search"></i></button>
                        </div>
                        <button class="btn btn-outline-dark btn-sm" onclick="loadCredList()"><i class="bi bi-arrow-clockwise"></i></button>
                        <button class="btn btn-success btn-sm" onclick="showCreateCredModal()"><i class="bi bi-plus-circle me-1"></i>创建凭据</button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height:55vh;overflow:auto">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="sticky-top bg-white">
                                <tr><th>凭据名</th><th>Token (脱敏)</th><th>状态</th><th>创建时间</th><th>最后使用</th><th>备注</th><th>操作</th></tr>
                            </thead>
                            <tbody id="credTableBody"><tr><td colspan="7" class="text-center text-muted py-4">加载中...</td></tr></tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <span class="text-muted small" id="credPageInfo">-</span>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary" id="credPrev" onclick="credChangePage(-1)"><i class="bi bi-chevron-left"></i></button>
                        <button class="btn btn-outline-secondary" id="credNext" onclick="credChangePage(1)"><i class="bi bi-chevron-right"></i></button>
                    </div>
                </div>
            </div>

            <!-- 集群 API 调用示例 -->
            <div class="card mt-3 border-info">
                <div class="card-header bg-info text-white">
                    <i class="bi bi-info-circle me-2"></i>集群 API 调用方式
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-2">用凭据 token 调以下接口获取可用的大模型 API 列表:</p>
                    <pre class="bg-dark text-light p-3 rounded small"><code>GET /api/cluster/llm-apis
Authorization: Bearer &lt;token&gt;

# 返回:
# {
#   "count": 2,
#   "apis": [
#     { "id":"...", "name":"GPT-4o", "provider":"openai",
#       "base_url":"https://api.openai.com/v1",
#       "api_key":"sk-...", "model_name":"gpt-4o",
#       "priority":100, "max_tokens":4096, "temperature":0.7 },
#     ...
#   ],
#   "fetched_at":"2026-07-05T..."
# }</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 创建凭据 Modal -->
<div class="modal fade" id="createCredModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-key me-2"></i>创建访问凭据</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">凭据名 *</label>
                    <input type="text" class="form-control" id="credAddName" placeholder="如:Tracker 节点 1">
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="credAddEnabled" checked>
                    <label class="form-check-label" for="credAddEnabled">启用</label>
                </div>
                <div class="mb-3">
                    <label class="form-label">备注 (可选)</label>
                    <input type="text" class="form-control" id="credAddNotes" placeholder="如:部署在北京节点的 Tracker">
                </div>
                <div id="credAddResult"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">取消</button>
                <button class="btn btn-success btn-sm" onclick="createCred()"><i class="bi bi-check-circle me-1"></i>创建</button>
            </div>
        </div>
    </div>
</div>

<script src="/js/llm-api-dashboard.js" asp-append-version="true"></script>
