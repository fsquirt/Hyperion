<div class="p-4">
    <!-- 顶部:全局配置卡片 -->
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center">
            <i class="bi bi-gear me-2"></i>Dump 触发配置(全局)
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label fw-semibold mb-2"><i class="bi bi-sliders me-1"></i>Dump 模式</label>
                    <div class="d-flex flex-wrap gap-3" id="dtDumpModeGroup">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="dtDumpMode" id="dtModeRaw" value="raw">
                            <label class="form-check-label" for="dtModeRaw">raw <small class="text-muted">(内存镜像)</small></label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="dtDumpMode" id="dtModeMini" value="mini">
                            <label class="form-check-label" for="dtModeMini">mini <small class="text-muted">(MiniDump)</small></label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="dtDumpMode" id="dtModeFull" value="full">
                            <label class="form-check-label" for="dtModeFull">full <small class="text-muted">(Full MiniDump)</small></label>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold mb-2"><i class="bi bi-clipboard-check me-1"></i>磁盘文件拷贝</label>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="dtFileCopy" checked>
                        <label class="form-check-label" for="dtFileCopy">启用磁盘文件拷贝</label>
                    </div>
                </div>
                <div class="col-md-3 text-md-end">
                    <button class="btn btn-primary" onclick="dtSaveConfig()">
                        <i class="bi bi-save me-1"></i>保存配置
                    </button>
                </div>
            </div>
            <div class="text-muted small mt-3">
                <i class="bi bi-info-circle me-1"></i>配置所有客户端下次启动时生效
            </div>
            <div id="dtConfigMsg" class="mt-2"></div>
        </div>
    </div>

    <div class="row g-3" style="min-height: 500px;">
        <!-- 左侧:会话列表 -->
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-hdd-rack me-2"></i>会话列表</span>
                    <button class="btn btn-outline-dark btn-sm" onclick="dtLoadSessions()" title="刷新"><i class="bi bi-arrow-clockwise"></i></button>
                </div>
                <div class="card-body p-0" style="overflow-y:auto; max-height:600px;">
                    <div id="dtSessionList" class="list-group list-group-flush">
                        <div class="text-center text-muted py-4">加载中...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 右侧:dump 记录 -->
        <div class="col-md-8">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span id="dtDetailTitle"><i class="bi bi-bug me-2"></i>Dump 触发记录</span>
                    <span id="dtDetailMeta" class="text-muted small"></span>
                </div>

                <!-- 汇总卡片行 (7 卡片, 从最新一条 dump 记录取值) -->
                <div id="dtSummaryCards" class="border-bottom p-3 d-none" style="background:#f8f9fa;">
                    <div class="row g-2">
                        <div class="col">
                            <div class="dt-stat-card">
                                <div class="stat-label">IOCTL 总数</div>
                                <div class="stat-value" id="dtStatIoctls">-</div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="dt-stat-card">
                                <div class="stat-label">事件总数</div>
                                <div class="stat-value" id="dtStatEvents">-</div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="dt-stat-card">
                                <div class="stat-label">路径数</div>
                                <div class="stat-value" id="dtStatPaths">-</div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="dt-stat-card stat-danger">
                                <div class="stat-label">异常路径</div>
                                <div class="stat-value" id="dtStatAbnormal">-</div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="dt-stat-card stat-warn">
                                <div class="stat-label">已 Dump</div>
                                <div class="stat-value" id="dtStatDumped">-</div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="dt-stat-card stat-info">
                                <div class="stat-label">已拷贝</div>
                                <div class="stat-value" id="dtStatCopied">-</div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="dt-stat-card stat-purple">
                                <div class="stat-label">驱动 Dump</div>
                                <div class="stat-value" id="dtStatDriverDumps">-</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 过滤栏 -->
                <div id="dtFilterBar" class="border-bottom px-3 py-2 d-none" style="background:#fafafa;">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="btn-group btn-group-sm" id="dtLevelFilter">
                            <button class="btn btn-outline-secondary active" data-level="" onclick="dtSetLevel(this)">全部</button>
                            <button class="btn btn-outline-danger" data-level="HIGH" onclick="dtSetLevel(this)">HIGH</button>
                            <button class="btn btn-outline-warning" data-level="WARN" onclick="dtSetLevel(this)">WARN</button>
                            <button class="btn btn-outline-primary" data-level="INFO" onclick="dtSetLevel(this)">INFO</button>
                        </div>
                        <div class="input-group input-group-sm" style="max-width:260px;">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" id="dtSearch" class="form-control" placeholder="搜索 dump/路径..." oninput="dtOnSearch()">
                            <button class="btn btn-outline-secondary" onclick="dtClearSearch()" title="清除"><i class="bi bi-x-lg"></i></button>
                        </div>
                        <span id="dtFilterCount" class="text-muted small ms-auto"></span>
                    </div>
                </div>
                <div class="card-body p-0" style="overflow-y:auto; max-height:600px;">
                    <div id="dtEventDetail">
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-cursor display-4 d-block mb-3"></i>
                            选择左侧会话查看 dump 记录
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.dt-session-item {
    cursor: pointer;
    transition: background 0.15s;
    border-left: 3px solid transparent;
}
.dt-session-item:hover { background: rgba(0,0,0,0.02); }
.dt-session-item.active {
    background: rgba(13,110,253,0.04);
    border-left-color: #0d6efd;
}
.dt-session-item .session-status {
    width: 8px; height: 8px;
    border-radius: 50%;
    display: inline-block;
    margin-right: 6px;
}
.dt-session-item .session-status.active { background: #16a34a; }
.dt-session-item .session-status.finished { background: #999; }

/* 汇总卡片 */
.dt-stat-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 0.5rem 0.7rem;
    text-align: center;
}
.dt-stat-card .stat-label {
    font-size: 0.7rem;
    color: #888;
    margin-bottom: 0.15rem;
    white-space: nowrap;
}
.dt-stat-card .stat-value {
    font-size: 1.3rem;
    font-weight: 700;
    color: #1a1a1a;
    font-family: monospace;
    line-height: 1.2;
}
.dt-stat-card.stat-danger { border-color: rgba(220,38,38,0.3); background: rgba(220,38,38,0.04); }
.dt-stat-card.stat-danger .stat-value { color: #dc2626; }
.dt-stat-card.stat-warn { border-color: rgba(217,119,6,0.3); background: rgba(217,119,6,0.04); }
.dt-stat-card.stat-warn .stat-value { color: #d97706; }
.dt-stat-card.stat-info { border-color: rgba(59,130,246,0.3); background: rgba(59,130,246,0.04); }
.dt-stat-card.stat-info .stat-value { color: #3b82f6; }
.dt-stat-card.stat-purple { border-color: rgba(139,92,246,0.3); background: rgba(139,92,246,0.04); }
.dt-stat-card.stat-purple .stat-value { color: #8b5cf6; }
.badge.bg-purple { background-color: #8b5cf6; color: #fff; }

/* dump 记录行 */
.dt-event-row {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid #f0f0f0;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.1s;
}
.dt-event-row:hover { background: rgba(0,0,0,0.02); }
.dt-event-row .event-time {
    color: #999;
    font-family: monospace;
    font-size: 0.8rem;
    white-space: nowrap;
    min-width: 100px;
}
.dt-event-row .event-level {
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.5px;
    min-width: 50px;
    text-align: center;
    padding: 1px 6px;
    border-radius: 2px;
}
.dt-event-row .event-level.HIGH  { background: rgba(220,38,38,0.1); color: #dc2626; }
.dt-event-row .event-level.WARN  { background: rgba(217,119,6,0.1);  color: #d97706; }
.dt-event-row .event-level.INFO  { background: rgba(59,130,246,0.08); color: #3b82f6; }
.dt-event-row .event-title { font-weight: 500; color: #1a1a1a; }

.dt-detail-panel {
    padding: 0.75rem 1rem;
    background: #f8f9fa;
    border-bottom: 1px solid #e0e0e0;
    font-size: 0.82rem;
    display: none;
}
.dt-detail-panel.open { display: block; }

/* 路径结构化表格 */
.dt-path-table {
    width: 100%;
    font-size: 0.78rem;
    border-collapse: collapse;
}
.dt-path-table thead th {
    background: #eee;
    padding: 0.3rem 0.5rem;
    text-align: left;
    font-weight: 600;
    color: #555;
    white-space: nowrap;
    position: sticky;
    top: 0;
}
.dt-path-table tbody tr {
    border-bottom: 1px solid #f0f0f0;
}
.dt-path-table tbody tr.dt-abnormal {
    background: rgba(220,38,38,0.05);
}
.dt-path-table tbody tr.dt-abnormal td { color: #b91c1c; }
.dt-path-table td {
    padding: 0.3rem 0.5rem;
    vertical-align: top;
    word-break: break-all;
}
.dt-path-table .mono { font-family: monospace; font-size: 0.76rem; }
.dt-path-table .tag-badge {
    font-size: 0.66rem;
    font-weight: 600;
    padding: 1px 5px;
    border-radius: 2px;
    background: rgba(99,102,241,0.12);
    color: #6366f1;
    white-space: nowrap;
}
.dt-path-table .abnormal-yes { color: #dc2626; font-weight: 600; }
.dt-path-table .abnormal-no { color: #999; }
.dt-path-table .note-text { color: #dc2626; font-size: 0.74rem; }
.dt-path-table .dump-yes { color: #16a34a; font-weight: 600; }
.dt-path-table .dump-no { color: #999; }
.dt-path-table .file-path-small {
    font-family: monospace;
    font-size: 0.72rem;
    color: #666;
    display: block;
    margin-top: 2px;
    word-break: break-all;
}

/* 驱动 dump 元数据表格 */
.dt-driver-dump-table {
    width: 100%;
    font-size: 0.78rem;
    border-collapse: collapse;
    margin-top: 0.3rem;
}
.dt-driver-dump-table thead th {
    background: #ede9fe;
    padding: 0.3rem 0.5rem;
    text-align: left;
    font-weight: 600;
    color: #6b21a8;
    white-space: nowrap;
    position: sticky;
    top: 0;
}
.dt-driver-dump-table tbody tr {
    border-bottom: 1px solid #f0f0f0;
}
.dt-driver-dump-table td {
    padding: 0.3rem 0.5rem;
    vertical-align: top;
    word-break: break-all;
}
.dt-driver-dump-table .mono { font-family: monospace; font-size: 0.76rem; }
.dt-driver-dump-table .status-ok { color: #16a34a; font-weight: 600; }
.dt-driver-dump-table .status-err { color: #dc2626; font-weight: 600; }

/* 路径目录区块 */
.dt-dir-section {
    margin-top: 0.5rem;
    padding: 0.5rem 0.6rem;
    background: #f8f9fa;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
}
.dt-dir-section .dir-title {
    font-weight: 600;
    color: #555;
    font-size: 0.8rem;
    margin-bottom: 0.3rem;
}
.dt-dir-kv {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 0.2rem 0.5rem;
    font-size: 0.78rem;
}
.dt-dir-kv .key { color: #666; }
.dt-dir-kv .val { color: #1a1a1a; font-family: monospace; word-break: break-all; }
.dt-dir-kv .val.empty { color: #999; font-family: inherit; }

/* 详情面板内小标题 */
.dt-detail-panel .detail-section {
    margin-bottom: 0.6rem;
}
.dt-detail-panel .detail-section-title {
    font-weight: 600;
    color: #333;
    margin-bottom: 0.3rem;
    font-size: 0.82rem;
}
</style>

<script src="/js/session-list.js" asp-append-version="true"></script>
<script src="/js/dump-trigger.js" asp-append-version="true"></script>
