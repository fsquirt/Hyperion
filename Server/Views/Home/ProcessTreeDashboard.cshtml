<div class="p-4">
    <!-- Tree 轮询频率配置 -->
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <span class="text-muted small"><i class="bi bi-clock-history me-1"></i>Tree 轮询频率:</span>
                <div class="input-group input-group-sm" style="max-width:200px;">
                    <input type="number" id="ptTreePollInput" class="form-control" min="1" max="3600" value="10">
                    <span class="input-group-text">秒</span>
                    <button class="btn btn-outline-primary" onclick="ptSaveTreePollConfig()">应用</button>
                </div>
                <span id="ptTreePollStatus" class="text-muted small"></span>
            </div>
        </div>
    </div>

    <div class="row g-3" style="min-height: 500px;">
        <!-- 左侧:会话列表 -->
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-hdd-rack me-2"></i>会话列表</span>
                    <button class="btn btn-outline-dark btn-sm" onclick="ptLoadSessions()"><i class="bi bi-arrow-clockwise"></i></button>
                </div>
                <div class="card-body p-0" style="overflow-y:auto; max-height:600px;">
                    <div id="ptSessionList" class="list-group list-group-flush">
                        <div class="text-center text-muted py-4">加载中...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 右侧:进程树快照 -->
        <div class="col-md-8">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span id="ptDetailTitle"><i class="bi bi-diagram-3 me-2"></i>进程树快照</span>
                    <span id="ptDetailMeta" class="text-muted small"></span>
                </div>

                <!-- 汇总卡片行 (4 安全卡片 + 6 Tree 统计卡片) -->
                <div id="ptSummaryCards" class="border-bottom p-3 d-none" style="background:#f8f9fa;">
                    <!-- 第一行: 安全维度 (security 快照为主) -->
                    <div class="row g-2 mb-2">
                        <div class="col-3">
                            <div class="pt-stat-card stat-danger">
                                <div class="stat-label">PPL 异常</div>
                                <div class="stat-value" id="ptStatPpl">0</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="pt-stat-card stat-warn">
                                <div class="stat-label">可疑内存</div>
                                <div class="stat-value" id="ptStatMem">0</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="pt-stat-card stat-danger">
                                <div class="stat-label">高危句柄</div>
                                <div class="stat-value" id="ptStatHandle">0</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="pt-stat-card">
                                <div class="stat-label">进程总数</div>
                                <div class="stat-value" id="ptStatProc">0</div>
                            </div>
                        </div>
                    </div>
                    <!-- 第二行: Tree 汇总统计 (Category C) -->
                    <div class="row g-2" id="ptTreeStatsRow">
                        <div class="col-2">
                            <div class="pt-stat-card stat-info">
                                <div class="stat-label">总线程数</div>
                                <div class="stat-value" id="ptStatTotalThreads">-</div>
                            </div>
                        </div>
                        <div class="col-2">
                            <div class="pt-stat-card stat-info">
                                <div class="stat-label">单进程最大线程</div>
                                <div class="stat-value" id="ptStatMaxThreads">-</div>
                            </div>
                        </div>
                        <div class="col-2">
                            <div class="pt-stat-card stat-info">
                                <div class="stat-label">线程最多 PID</div>
                                <div class="stat-value" id="ptStatTopPid">-</div>
                            </div>
                        </div>
                        <div class="col-2">
                            <div class="pt-stat-card stat-info">
                                <div class="stat-label">总工作集</div>
                                <div class="stat-value" id="ptStatTotalWS">-</div>
                            </div>
                        </div>
                        <div class="col-2">
                            <div class="pt-stat-card stat-info">
                                <div class="stat-label">总私有内存</div>
                                <div class="stat-value" id="ptStatTotalPP">-</div>
                            </div>
                        </div>
                        <div class="col-2">
                            <div class="pt-stat-card stat-info">
                                <div class="stat-label">总句柄数</div>
                                <div class="stat-value" id="ptStatTotalHandles">-</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 过滤栏 -->
                <div id="ptFilterBar" class="border-bottom px-3 py-2 d-none" style="background:#fafafa;">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="btn-group btn-group-sm" id="ptKindFilter">
                            <button class="btn btn-outline-secondary active" data-kind="" onclick="ptSetKind(this)">全部</button>
                            <button class="btn btn-outline-primary" data-kind="security" onclick="ptSetKind(this)">初始快照</button>
                            <button class="btn btn-outline-success" data-kind="tree" onclick="ptSetKind(this)">轮询</button>
                        </div>
                        <div class="input-group input-group-sm" style="max-width:220px;">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" id="ptSearch" class="form-control" placeholder="搜索进程名/PID..." oninput="ptOnSearch()">
                            <button class="btn btn-outline-secondary" onclick="ptClearSearch()" title="清除"><i class="bi bi-x-lg"></i></button>
                        </div>
                        <span id="ptFilterCount" class="text-muted small ms-auto"></span>
                    </div>
                </div>
                <div class="card-body p-0 d-flex flex-column" style="height:600px;">
                    <!-- 顶部:快照列表 -->
                    <div id="ptSnapshotListWrap" class="border-bottom" style="overflow-y:auto; max-height:220px; display:none;">
                        <div id="ptSnapshotList" class="list-group list-group-flush"></div>
                    </div>
                    <!-- 下方:进程树展示区 -->
                    <div id="ptTreeWrap" class="flex-grow-1" style="overflow-y:auto;">
                        <div id="ptEventDetail">
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-cursor display-4 d-block mb-3"></i>
                                选择左侧会话查看进程树快照
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 进程详情 Modal (5 Tab: 基本信息/线程/模块/内存/句柄) -->
<div class="modal fade" id="ptProcDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ptModalTitle">进程详情</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul class="nav nav-tabs" id="ptModalTabNav">
                    <li class="nav-item">
                        <a class="nav-link active" data-mtab="basic" onclick="ptSetModalTab('basic')">
                            <i class="bi bi-info-circle me-1"></i>基本信息
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-mtab="threads" onclick="ptSetModalTab('threads')">
                            <i class="bi bi-list-ol me-1"></i>线程
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-mtab="modules" onclick="ptSetModalTab('modules')">
                            <i class="bi bi-box-seam me-1"></i>模块
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-mtab="memory" onclick="ptSetModalTab('memory')">
                            <i class="bi bi-memory me-1"></i>内存
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-mtab="handles" onclick="ptSetModalTab('handles')">
                            <i class="bi bi-key me-1"></i>句柄
                        </a>
                    </li>
                </ul>
                <div class="tab-content p-3" id="ptModalTabContent">
                    <!-- 动态填充 -->
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.pt-session-item {
    cursor: pointer;
    transition: background 0.15s;
    border-left: 3px solid transparent;
}
.pt-session-item:hover { background: rgba(0,0,0,0.02); }
.pt-session-item.active {
    background: rgba(13,110,253,0.04);
    border-left-color: #0d6efd;
}
.pt-session-item .session-status {
    width: 8px; height: 8px;
    border-radius: 50%;
    display: inline-block;
    margin-right: 6px;
}
.pt-session-item .session-status.active { background: #16a34a; }
.pt-session-item .session-status.finished { background: #999; }

/* 汇总卡片 */
.pt-stat-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 0.5rem 0.7rem;
    text-align: center;
}
.pt-stat-card .stat-label {
    font-size: 0.7rem;
    color: #888;
    margin-bottom: 0.15rem;
    white-space: nowrap;
}
.pt-stat-card .stat-value {
    font-size: 1.3rem;
    font-weight: 700;
    color: #1a1a1a;
    font-family: monospace;
    line-height: 1.2;
}
.pt-stat-card.stat-danger { border-color: rgba(220,38,38,0.3); background: rgba(220,38,38,0.04); }
.pt-stat-card.stat-danger .stat-value { color: #dc2626; }
.pt-stat-card.stat-warn { border-color: rgba(217,119,6,0.3); background: rgba(217,119,6,0.04); }
.pt-stat-card.stat-warn .stat-value { color: #d97706; }
.pt-stat-card.stat-info { border-color: rgba(59,130,246,0.3); background: rgba(59,130,246,0.04); }
.pt-stat-card.stat-info .stat-value { color: #3b82f6; }

/* 快照列表项 */
.pt-snapshot-list-item {
    padding: 0.5rem 1rem;
    border-bottom: 1px solid #f0f0f0;
    font-size: 0.82rem;
    cursor: pointer;
    transition: background 0.1s;
    display: flex;
    align-items: center;
    gap: 0.6rem;
}
.pt-snapshot-list-item:hover { background: rgba(0,0,0,0.02); }
.pt-snapshot-list-item.active {
    background: rgba(13,110,253,0.06);
    border-left: 3px solid #0d6efd;
}
.pt-snapshot-list-item .snap-time {
    color: #999;
    font-family: monospace;
    font-size: 0.78rem;
    white-space: nowrap;
}
.pt-snapshot-list-item .snap-kind {
    font-weight: 600;
    font-size: 0.68rem;
    letter-spacing: 0.3px;
    min-width: 56px;
    text-align: center;
    padding: 1px 6px;
    border-radius: 2px;
    font-family: monospace;
}
.pt-snapshot-list-item .snap-kind.security {
    background: rgba(59,130,246,0.12);
    color: #2563eb;
}
.pt-snapshot-list-item .snap-kind.tree {
    background: rgba(22,163,74,0.12);
    color: #16a34a;
}
.pt-snapshot-list-item .snap-count {
    color: #666;
    font-size: 0.78rem;
}
.pt-snapshot-list-item .snap-diff {
    margin-left: auto;
    font-size: 0.72rem;
}
.pt-snapshot-list-item .snap-diff .added { color: #16a34a; }
.pt-snapshot-list-item .snap-diff .removed { color: #dc2626; }

/* 进程树 */
.pt-tree {
    list-style: none;
    padding-left: 0;
    margin: 0;
    font-size: 0.82rem;
}
.pt-tree ul {
    list-style: none;
    padding-left: 1.4rem;
    margin: 0;
    border-left: 1px dashed #d0d0d0;
}
.pt-tree-node {
    position: relative;
    padding: 1px 0;
}
.pt-tree-node-content {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 2px 6px;
    border-radius: 3px;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.1s;
}
.pt-tree-node-content:hover { background: rgba(13,110,253,0.08); }
.pt-tree-node-content .npid {
    font-family: monospace;
    font-weight: 600;
    color: #2563eb;
    font-size: 0.78rem;
}
.pt-tree-node-content .nname { color: #1a1a1a; }
.pt-tree-node-content .nmeta {
    color: #888;
    font-size: 0.74rem;
}
.pt-tree-node-content .nsession {
    color: #7c3aed;
    font-size: 0.72rem;
    font-family: monospace;
}
.pt-tree-node-content .click-hint {
    color: #0d6efd;
    font-size: 0.66rem;
    opacity: 0;
    transition: opacity 0.15s;
}
.pt-tree-node-content:hover .click-hint { opacity: 0.7; }

/* diff 高亮 */
.pt-tree-node-content.new {
    background: rgba(22,163,74,0.14);
    outline: 1px solid rgba(22,163,74,0.35);
}
.pt-tree-node-content.new .npid { color: #15803d; }
.pt-tree-node-content.removed {
    background: rgba(220,38,38,0.10);
    outline: 1px solid rgba(220,38,38,0.30);
    text-decoration: line-through;
    text-decoration-color: rgba(220,38,38,0.7);
    color: #b91c1c;
}
.pt-tree-node-content.removed .npid { color: #b91c1c; }
.pt-tree-node-content.removed .nname { color: #b91c1c; }

.pt-tree-legend {
    padding: 0.4rem 1rem;
    background: #fafafa;
    border-bottom: 1px solid #f0f0f0;
    font-size: 0.74rem;
    color: #666;
    display: flex;
    gap: 1rem;
    align-items: center;
}
.pt-tree-legend .dot {
    display: inline-block;
    width: 10px; height: 10px;
    border-radius: 2px;
    margin-right: 4px;
    vertical-align: middle;
}
.pt-tree-legend .dot.new { background: rgba(22,163,74,0.35); border:1px solid #16a34a; }
.pt-tree-legend .dot.removed { background: rgba(220,38,38,0.30); border:1px solid #dc2626; }
.pt-tree-legend .dot.normal { background: #e5e7eb; border:1px solid #bbb; }

/* Modal 内表格 */
.pt-modal-tab-table {
    width: 100%;
    font-size: 0.78rem;
    border-collapse: collapse;
}
.pt-modal-tab-table thead th {
    background: #f8f9fa;
    padding: 0.3rem 0.5rem;
    text-align: left;
    font-weight: 600;
    color: #555;
    border-bottom: 1px solid #e0e0e0;
    white-space: nowrap;
    position: sticky;
    top: 0;
}
.pt-modal-tab-table tbody tr {
    border-bottom: 1px solid #f0f0f0;
}
.pt-modal-tab-table tbody tr:hover { background: rgba(0,0,0,0.02); }
.pt-modal-tab-table td {
    padding: 0.3rem 0.5rem;
    vertical-align: top;
    word-break: break-all;
}
.pt-modal-tab-table .mono { font-family: monospace; font-size: 0.76rem; }

/* 安全高亮 */
.pt-win32-mismatch {
    background: rgba(220,38,38,0.06) !important;
}
.pt-win32-mismatch td { color: #b91c1c; }
.pt-win32-mismatch .mismatch-flag {
    color: #dc2626;
    font-weight: 600;
    font-size: 0.68rem;
    margin-left: 4px;
}

.pt-mem-suspicious {
    background: rgba(220,38,38,0.06) !important;
}
.pt-mem-suspicious td { color: #b91c1c; }
.pt-mem-suspicious .reason-badge {
    background: rgba(220,38,38,0.15);
    color: #dc2626;
    font-weight: 600;
    font-size: 0.66rem;
    padding: 1px 5px;
    border-radius: 2px;
}

.pt-handle-highrisk {
    background: rgba(220,38,38,0.06) !important;
}
.pt-handle-highrisk td { color: #b91c1c; }
.pt-handle-highrisk .highrisk-badge {
    background: rgba(220,38,38,0.15);
    color: #dc2626;
    font-weight: 600;
    font-size: 0.66rem;
    padding: 1px 5px;
    border-radius: 2px;
}

/* Modal 键值对网格 */
.pt-modal-kv {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 0.3rem 0.6rem;
    font-size: 0.8rem;
}
.pt-modal-kv .key { color: #666; font-weight: 500; }
.pt-modal-kv .val { color: #1a1a1a; word-break: break-all; }
.pt-modal-kv .val.mono { font-family: monospace; font-size: 0.78rem; }

.pt-priv-section {
    margin-top: 0.6rem;
    padding: 0.5rem;
    background: #f8f9fa;
    border-radius: 4px;
}
.pt-priv-section .priv-title {
    font-weight: 600;
    font-size: 0.78rem;
    margin-bottom: 0.3rem;
}
.pt-priv-section .priv-badge {
    display: inline-block;
    font-size: 0.68rem;
    font-family: monospace;
    padding: 1px 5px;
    border-radius: 2px;
    margin: 1px 2px;
}
.pt-priv-section .priv-enabled { background: rgba(220,38,38,0.12); color: #dc2626; }
.pt-priv-section .priv-disabled { background: rgba(156,163,175,0.15); color: #6b7280; }

.pt-modal-empty {
    text-align: center;
    color: #999;
    padding: 2rem;
    font-size: 0.85rem;
}
</style>

<script src="/js/session-list.js" asp-append-version="true"></script>
<script src="/js/process-tree.js" asp-append-version="true"></script>
