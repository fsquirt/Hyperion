<div class="p-3">
    <!-- 顶部: 轮询配置 -->
    <div class="card mb-2">
        <div class="card-body py-2">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <span class="text-muted small"><i class="bi bi-clock-history me-1"></i>Tree 轮询:</span>
                <div class="input-group input-group-sm" style="max-width:180px;">
                    <input type="number" id="ptTreePollInput" class="form-control" min="1" max="3600" value="10">
                    <span class="input-group-text">秒</span>
                    <button class="btn btn-outline-primary" onclick="ptSaveTreePollConfig()">应用</button>
                </div>
                <span id="ptTreePollStatus" class="text-muted small"></span>
            </div>
        </div>
    </div>

    <!-- Sparkline 行 — 快照选择器 (不是滑块, 是趋势曲线, 点击曲线上的点选快照) -->
    <div id="ptSparklineWrap" class="card mb-2 d-none">
        <div class="card-body py-2">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="text-muted small fw-bold"><i class="bi bi-graph-up me-1"></i>快照趋势</span>
                <span class="text-muted small">— 点击曲线上任意位置切换快照</span>
                <div class="btn-group btn-group-sm ms-2" id="ptKindFilter">
                    <button class="btn btn-outline-secondary active" data-kind="" onclick="ptSetKind(this)">全部</button>
                    <button class="btn btn-outline-primary" data-kind="security" onclick="ptSetKind(this)">初始</button>
                    <button class="btn btn-outline-success" data-kind="tree" onclick="ptSetKind(this)">轮询</button>
                </div>
                <div class="input-group input-group-sm ms-auto" style="max-width:220px;">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" id="ptSearch" class="form-control" placeholder="搜索进程名/PID..." oninput="ptOnSearch()">
                    <button class="btn btn-outline-secondary" onclick="ptClearSearch()" title="清除"><i class="bi bi-x-lg"></i></button>
                </div>
            </div>
            <div class="row g-2">
                <div class="col-md-4">
                    <div class="pt-spark-box">
                        <div class="pt-spark-label"><i class="bi bi-list-ol me-1"></i>总线程</div>
                        <svg id="ptSparkThreads" class="pt-spark"></svg>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="pt-spark-box">
                        <div class="pt-spark-label"><i class="bi bi-memory me-1"></i>总工作集</div>
                        <svg id="ptSparkMem" class="pt-spark"></svg>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="pt-spark-box">
                        <div class="pt-spark-label"><i class="bi bi-key me-1"></i>总句柄</div>
                        <svg id="ptSparkHandles" class="pt-spark"></svg>
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 mt-2">
                <button class="btn btn-sm btn-outline-secondary" onclick="ptTimelinePrev()" title="上一个快照">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <span id="ptSnapshotInfo" class="text-muted small"></span>
                <button class="btn btn-sm btn-outline-secondary" onclick="ptTimelineNext()" title="下一个快照">
                    <i class="bi bi-chevron-right"></i>
                </button>
                <span id="ptDiffSummary" class="pt-diff-summary d-none ms-2"></span>
            </div>
        </div>
    </div>

    <!-- 主行: 会话列表(窄) + 力导向图(主) + 雷达图(右) -->
    <div class="row g-2" style="min-height:680px;">
        <!-- 会话列表 (窄列) -->
        <div class="col-md-2">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center py-2">
                    <span class="small"><i class="bi bi-hdd-rack me-1"></i>会话</span>
                    <button class="btn btn-outline-dark btn-sm py-0 px-1" onclick="ptLoadSessions()"><i class="bi bi-arrow-clockwise"></i></button>
                </div>
                <div class="card-body p-0" style="overflow-y:auto; max-height:680px;">
                    <div id="ptSessionList" class="list-group list-group-flush">
                        <div class="text-center text-muted py-4 small">加载中...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 力导向图 (主画布) -->
        <div class="col-md-7">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center py-2 flex-wrap gap-1">
                    <span id="ptDetailTitle" class="small fw-bold"><i class="bi bi-share-fill me-1"></i>力导向进程图</span>
                    <div class="d-flex align-items-center gap-1 flex-wrap">
                        <select id="ptSizeEnc" class="form-select form-select-sm py-0" style="width:auto;font-size:0.72rem;" onchange="ptSetSizeEncoding(this.value)">
                            <option value="threads">大小:线程</option>
                            <option value="workingSet">大小:工作集</option>
                            <option value="handles">大小:句柄</option>
                            <option value="privatePages">大小:私有页</option>
                        </select>
                        <select id="ptColorEnc" class="form-select form-select-sm py-0" style="width:auto;font-size:0.72rem;" onchange="ptSetColorEncoding(this.value)">
                            <option value="security">颜色:安全</option>
                            <option value="kind">颜色:类型</option>
                        </select>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary py-0" onclick="ptZoomIn()" title="放大"><i class="bi bi-zoom-in"></i></button>
                            <button class="btn btn-outline-secondary py-0" onclick="ptZoomOut()" title="缩小"><i class="bi bi-zoom-out"></i></button>
                            <button class="btn btn-outline-secondary py-0" onclick="ptResetZoom()" title="重置视图"><i class="bi bi-arrow-repeat"></i></button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0 position-relative" style="height:680px;">
                    <svg id="ptGraph" style="width:100%;height:100%;background:#fafbfc;"></svg>
                    <!-- 图例 -->
                    <div class="pt-graph-legend">
                        <span><span class="pt-dot sec-normal"></span>正常</span>
                        <span><span class="pt-dot sec-ppl"></span>PPL破</span>
                        <span><span class="pt-dot sec-mem"></span>可疑内存</span>
                        <span><span class="pt-dot sec-handle"></span>高危句柄</span>
                        <span><span class="pt-dot sec-untrusted"></span>不受信</span>
                        <span class="ms-2"><span class="pt-dot diff-new"></span>新增</span>
                        <span><span class="pt-dot diff-removed"></span>消失</span>
                        <span><span class="pt-dot diff-changed"></span>变化</span>
                    </div>
                    <!-- 空状态 -->
                    <div id="ptGraphEmpty" class="position-absolute top-50 start-50 translate-middle text-center text-muted">
                        <i class="bi bi-share display-4 d-block mb-3"></i>
                        选择左侧会话查看进程图
                    </div>
                    <!-- Tooltip -->
                    <div id="ptGraphTooltip" class="pt-graph-tooltip d-none"></div>
                </div>
            </div>
        </div>

        <!-- 雷达图 + 节点信息 (右侧, 没有 tab) -->
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-header py-2">
                    <span id="ptRadarTitle" class="small fw-bold"><i class="bi bi-activity me-1"></i>多维雷达</span>
                </div>
                <div class="card-body p-2 d-flex flex-column" style="height:680px;">
                    <div id="ptRadarEmpty" class="text-center text-muted py-5">
                        <i class="bi bi-cursor display-4 d-block mb-3"></i>
                        <div class="small">点击图中节点<br>查看多维雷达</div>
                    </div>
                    <div id="ptRadarContent" class="d-none flex-grow-1" style="overflow-y:auto;">
                        <svg id="ptRadarSvg" viewBox="0 0 220 220" style="width:100%;"></svg>
                        <div id="ptNodeInfo" class="mt-2"></div>
                        <div id="ptNodeDetail" class="mt-2"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 底部: 异常进程清单 (只列安全问题, 点击跳到图中高亮) -->
    <div class="card mt-2">
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <span class="small fw-bold"><i class="bi bi-exclamation-triangle me-1"></i>异常进程清单</span>
            <span id="ptAnomalyCount" class="text-muted small"></span>
        </div>
        <div class="card-body p-2">
            <div id="ptAnomalyList" class="d-flex flex-wrap gap-2">
                <div class="text-center text-muted py-2 w-100 small">选择会话查看异常进程</div>
            </div>
        </div>
    </div>
</div>

<style>
/* ═══════════════════════════════════════════════════════════════
 *  会话列表项
 * ═══════════════════════════════════════════════════════════════ */
.pt-session-item {
    cursor: pointer;
    transition: background 0.15s;
    border-left: 3px solid transparent;
    padding: 0.4rem 0.5rem;
    font-size: 0.78rem;
}
.pt-session-item:hover { background: rgba(0,0,0,0.02); }
.pt-session-item.active {
    background: rgba(13,110,253,0.04);
    border-left-color: #0d6efd;
}
.pt-session-item .session-status {
    width: 7px; height: 7px;
    border-radius: 50%;
    display: inline-block;
    margin-right: 5px;
}
.pt-session-item .session-status.active { background: #16a34a; }
.pt-session-item .session-status.finished { background: #999; }

/* ═══════════════════════════════════════════════════════════════
 *  Sparkline 快照选择器
 * ═══════════════════════════════════════════════════════════════ */
.pt-spark-box {
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 0.25rem 0.5rem;
    background: #fff;
}
.pt-spark-label {
    font-size: 0.68rem;
    color: #666;
    margin-bottom: 0.1rem;
    font-weight: 500;
}
.pt-spark {
    width: 100%;
    height: 48px;
    display: block;
    cursor: crosshair;
}
.pt-spark .spark-click-target {
    fill: transparent;
    cursor: pointer;
}
.pt-spark .spark-click-target:hover {
    fill: rgba(13,110,253,0.06);
}
.pt-spark .spark-line {
    fill: none;
    stroke: #0d6efd;
    stroke-width: 1.5;
}
.pt-spark .spark-area {
    fill: rgba(13,110,253,0.08);
}
.pt-spark .spark-dot {
    fill: #0d6efd;
    stroke: #fff;
    stroke-width: 1;
    pointer-events: none;
}
.pt-spark .spark-dot.selected {
    fill: #dc2626;
    r: 4;
}
.pt-spark .spark-vline {
    stroke: #dc2626;
    stroke-width: 1;
    stroke-dasharray: 2,2;
    pointer-events: none;
}

.pt-diff-summary {
    font-size: 0.72rem;
    font-family: monospace;
    padding: 1px 6px;
    border-radius: 3px;
    background: rgba(13,110,253,0.08);
    color: #0d6efd;
}

/* ═══════════════════════════════════════════════════════════════
 *  力导向图
 * ═══════════════════════════════════════════════════════════════ */
.pt-graph {
    cursor: grab;
}
.pt-graph:active {
    cursor: grabbing;
}
.pt-graph .pt-link {
    stroke: #d0d0d0;
    stroke-width: 1;
    fill: none;
}
.pt-graph .pt-link.diff-removed {
    stroke: rgba(220,38,38,0.3);
    stroke-dasharray: 3,3;
}
.pt-graph .pt-node {
    cursor: pointer;
    stroke: #fff;
    stroke-width: 1.5;
    transition: stroke-width 0.15s;
}
.pt-graph .pt-node:hover {
    stroke-width: 3;
}
.pt-graph .pt-node.selected {
    stroke: #0d6efd;
    stroke-width: 3;
}
.pt-graph .pt-node-label {
    font-size: 8px;
    fill: #666;
    pointer-events: none;
    text-anchor: middle;
    user-select: none;
}
.pt-graph .pt-node-label.selected {
    fill: #0d6efd;
    font-weight: 700;
}

/* 图例 */
.pt-graph-legend {
    position: absolute;
    bottom: 6px;
    left: 6px;
    background: rgba(255,255,255,0.92);
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 0.66rem;
    color: #666;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    align-items: center;
    pointer-events: none;
}
.pt-graph-legend .pt-dot {
    display: inline-block;
    width: 8px; height: 8px;
    border-radius: 50%;
    margin-right: 2px;
    vertical-align: middle;
    border: 1px solid rgba(0,0,0,0.1);
}
.pt-graph-legend .pt-dot.sec-normal { background: #6b7280; }
.pt-graph-legend .pt-dot.sec-ppl { background: #dc2626; }
.pt-graph-legend .pt-dot.sec-mem { background: #f59e0b; }
.pt-graph-legend .pt-dot.sec-handle { background: #d97706; }
.pt-graph-legend .pt-dot.sec-untrusted { background: #7c3aed; }
.pt-graph-legend .pt-dot.diff-new { background: #16a34a; }
.pt-graph-legend .pt-dot.diff-removed { background: #dc2626; opacity: 0.5; }
.pt-graph-legend .pt-dot.diff-changed { background: #f59e0b; }

/* Tooltip */
.pt-graph-tooltip {
    position: absolute;
    background: rgba(26,26,26,0.95);
    color: #fff;
    padding: 4px 8px;
    border-radius: 3px;
    font-size: 0.7rem;
    pointer-events: none;
    z-index: 10;
    white-space: nowrap;
    max-width: 300px;
}
.pt-graph-tooltip .tt-title {
    font-weight: 700;
    margin-bottom: 2px;
}
.pt-graph-tooltip .tt-row {
    font-family: monospace;
    font-size: 0.66rem;
    color: #ccc;
}

/* diff 动画 */
@@keyframes ptPulseNew {
    0%, 100% { stroke-opacity: 1; }
    50% { stroke-opacity: 0.3; }
}
.pt-graph .pt-node.diff-new {
    animation: ptPulseNew 1.5s ease-in-out infinite;
}
.pt-graph .pt-node.diff-removed {
    opacity: 0.4;
    stroke-dasharray: 2,2;
}

/* ═══════════════════════════════════════════════════════════════
 *  雷达图
 * ═══════════════════════════════════════════════════════════════ */
.pt-radar {
    background: #fff;
}
.pt-radar .radar-grid {
    fill: none;
    stroke: #e5e7eb;
    stroke-width: 0.5;
}
.pt-radar .radar-axis {
    stroke: #d0d0d0;
    stroke-width: 0.5;
}
.pt-radar .radar-axis-label {
    font-size: 9px;
    fill: #666;
    text-anchor: middle;
    dominant-baseline: middle;
}
.pt-radar .radar-axis-value {
    font-size: 7px;
    fill: #999;
    text-anchor: middle;
    dominant-baseline: middle;
    font-family: monospace;
}
.pt-radar .radar-polygon {
    fill: rgba(13,110,253,0.2);
    stroke: #0d6efd;
    stroke-width: 1.5;
}
.pt-radar .radar-point {
    fill: #0d6efd;
}
.pt-radar .radar-point.critical {
    fill: #dc2626;
}

/* 节点信息 */
.pt-node-info {
    font-size: 0.76rem;
}
.pt-node-info .kv {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 0.15rem 0.4rem;
}
.pt-node-info .kv .k {
    color: #888;
    font-weight: 500;
}
.pt-node-info .kv .v {
    color: #1a1a1a;
    word-break: break-all;
}
.pt-node-info .kv .v.mono {
    font-family: monospace;
    font-size: 0.74rem;
}
.pt-node-info .flag-badges {
    margin-top: 0.4rem;
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
}
.pt-node-info .flag-badge {
    font-size: 0.66rem;
    padding: 1px 5px;
    border-radius: 3px;
    font-weight: 600;
}
.pt-node-info .flag-badge.ppl { background: rgba(220,38,38,0.15); color: #dc2626; }
.pt-node-info .flag-badge.mem { background: rgba(245,158,11,0.15); color: #d97706; }
.pt-node-info .flag-badge.handle { background: rgba(217,119,6,0.15); color: #b45309; }
.pt-node-info .flag-badge.untrusted { background: rgba(124,58,237,0.15); color: #7c3aed; }

/* ═══════════════════════════════════════════════════════════════
 *  异常清单
 * ═══════════════════════════════════════════════════════════════ */
.pt-anomaly-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    background: #fff;
    cursor: pointer;
    transition: all 0.15s;
    font-size: 0.74rem;
}
.pt-anomaly-chip:hover {
    border-color: #dc2626;
    background: rgba(220,38,38,0.04);
}
.pt-anomaly-chip .pid {
    font-family: monospace;
    font-weight: 700;
    color: #2563eb;
}
.pt-anomaly-chip .name {
    color: #1a1a1a;
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.pt-anomaly-chip .badge {
    font-size: 0.6rem;
    font-weight: 600;
}
.pt-anomaly-chip.focused {
    border-color: #dc2626;
    box-shadow: 0 0 0 2px rgba(220,38,38,0.2);
}
</style>

<script src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"></script>
<script src="/js/session-list.js" asp-append-version="true"></script>
<script src="/js/process-tree.js" asp-append-version="true"></script>
