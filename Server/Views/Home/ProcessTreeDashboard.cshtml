<div class="p-4">
    <!-- Tree 轮询频率配置 -->
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <span class="text-muted small"><i class="bi bi-clock-history me-1"></i>Tree 轮询频率:</span>
                <div class="input-group input-group-sm" style="max-width:200px;">
                    <input type="number" id="ptTreePollInput" class="form-control" min="1" max="3600" value="10">
                    <span class="input-group-text">秒</span>
                    <button class="btn btn-outline-primary" onclick="ptSaveTreePollConfig()">应用</button>
                </div>
                <span id="ptTreePollStatus" class="text-muted small"></span>
            </div>
        </div>
    </div>

    <div class="row g-3" style="min-height: 500px;">
        <!-- 左侧:会话列表 -->
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-hdd-rack me-2"></i>会话列表</span>
                    <button class="btn btn-outline-dark btn-sm" onclick="ptLoadSessions()"><i class="bi bi-arrow-clockwise"></i></button>
                </div>
                <div class="card-body p-0" style="overflow-y:auto; max-height:600px;">
                    <div id="ptSessionList" class="list-group list-group-flush">
                        <div class="text-center text-muted py-4">加载中...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 右侧:进程快照/树 -->
        <div class="col-md-8">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span id="ptDetailTitle"><i class="bi bi-diagram-3 me-2"></i>进程快照 / 树</span>
                    <span id="ptDetailMeta" class="text-muted small"></span>
                </div>
                <!-- 过滤栏 -->
                <div id="ptFilterBar" class="border-bottom px-3 py-2 d-none" style="background:#fafafa;">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="btn-group btn-group-sm" id="ptModeFilter">
                            <button class="btn btn-outline-secondary active" data-mode="snapshot,tree" onclick="ptSetMode(this)">全部</button>
                            <button class="btn btn-outline-primary" data-mode="snapshot" onclick="ptSetMode(this)">初始快照</button>
                            <button class="btn btn-outline-success" data-mode="tree" onclick="ptSetMode(this)">轮询</button>
                        </div>
                        <div class="btn-group btn-group-sm" id="ptLevelFilter">
                            <button class="btn btn-outline-secondary active" data-level="" onclick="ptSetLevel(this)">全部</button>
                            <button class="btn btn-outline-danger" data-level="HIGH" onclick="ptSetLevel(this)">HIGH</button>
                            <button class="btn btn-outline-warning" data-level="WARN" onclick="ptSetLevel(this)">WARN</button>
                        </div>
                        <div class="input-group input-group-sm" style="max-width:220px;">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" id="ptSearch" class="form-control" placeholder="搜索进程名/PID..." oninput="ptOnSearch()">
                            <button class="btn btn-outline-secondary" onclick="ptClearSearch()" title="清除"><i class="bi bi-x-lg"></i></button>
                        </div>
                        <span id="ptFilterCount" class="text-muted small ms-auto"></span>
                    </div>
                </div>
                <div class="card-body p-0" style="overflow-y:auto; max-height:600px;">
                    <div id="ptEventDetail">
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-cursor display-4 d-block mb-3"></i>
                            选择左侧会话查看进程快照
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.pt-session-item {
    cursor: pointer;
    transition: background 0.15s;
    border-left: 3px solid transparent;
}
.pt-session-item:hover { background: rgba(0,0,0,0.02); }
.pt-session-item.active {
    background: rgba(13,110,253,0.04);
    border-left-color: #0d6efd;
}
.pt-session-item .session-status {
    width: 8px; height: 8px;
    border-radius: 50%;
    display: inline-block;
    margin-right: 6px;
}
.pt-session-item .session-status.active { background: #16a34a; }
.pt-session-item .session-status.finished { background: #999; }

.pt-event-row {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid #f0f0f0;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.1s;
}
.pt-event-row:hover { background: rgba(0,0,0,0.02); }
.pt-event-row .event-time {
    color: #999;
    font-family: monospace;
    font-size: 0.8rem;
    white-space: nowrap;
    min-width: 100px;
}
.pt-event-row .event-level {
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.5px;
    min-width: 50px;
    text-align: center;
    padding: 1px 6px;
    border-radius: 2px;
}
.pt-event-row .event-level.HIGH  { background: rgba(220,38,38,0.1); color: #dc2626; }
.pt-event-row .event-level.WARN  { background: rgba(217,119,6,0.1);  color: #d97706; }
.pt-event-row .event-level.INFO  { background: rgba(59,130,246,0.08); color: #3b82f6; }
.pt-event-row .event-type {
    font-size: 0.7rem;
    letter-spacing: 0.3px;
    min-width: 60px;
    text-align: center;
    padding: 1px 6px;
    border-radius: 2px;
    background: rgba(107,114,128,0.08);
    color: #6b7280;
    font-family: monospace;
}
.pt-event-row .event-title { font-weight: 500; color: #1a1a1a; }
.pt-event-row .event-source { color: #666; font-size: 0.8rem; }

.pt-detail-panel {
    padding: 0.75rem 1rem;
    background: #f8f9fa;
    border-bottom: 1px solid #e0e0e0;
    font-size: 0.82rem;
    display: none;
}
.pt-detail-panel.open { display: block; }
.pt-detail-panel pre {
    margin: 0;
    font-size: 0.8rem;
    white-space: pre-wrap;
    word-break: break-all;
    color: #333;
}
</style>

<script src="/js/process-tree.js" asp-append-version="true"></script>
