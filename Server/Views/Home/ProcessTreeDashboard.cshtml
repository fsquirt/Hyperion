<div class="p-3">
    <!-- 顶部: 轮询配置 -->
    <div class="card mb-2">
        <div class="card-body py-2">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <span class="text-muted small"><i class="bi bi-clock-history me-1"></i>Tree 轮询:</span>
                <div class="input-group input-group-sm" style="max-width:180px;">
                    <input type="number" id="ptTreePollInput" class="form-control" min="1" max="3600" value="10">
                    <span class="input-group-text">秒</span>
                    <button class="btn btn-outline-primary" onclick="ptSaveTreePollConfig()">应用</button>
                </div>
                <span id="ptTreePollStatus" class="text-muted small"></span>
            </div>
        </div>
    </div>

    <!-- Sparkline 行 — 快照选择器 (不是滑块, 是趋势曲线, 点击曲线上的点选快照) -->
    <div id="ptSparklineWrap" class="card mb-2 d-none">
        <div class="card-body py-2">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="text-muted small fw-bold"><i class="bi bi-graph-up me-1"></i>快照趋势</span>
                <span class="text-muted small">— 点击曲线上任意位置切换快照</span>
                <div class="btn-group btn-group-sm ms-2" id="ptKindFilter">
                    <button class="btn btn-outline-secondary active" data-kind="" onclick="ptSetKind(this)">全部</button>
                    <button class="btn btn-outline-primary" data-kind="security" onclick="ptSetKind(this)">初始</button>
                    <button class="btn btn-outline-success" data-kind="tree" onclick="ptSetKind(this)">轮询</button>
                </div>
                <div class="input-group input-group-sm ms-auto" style="max-width:220px;">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" id="ptSearch" class="form-control" placeholder="搜索进程名/PID..." oninput="ptOnSearch()">
                    <button class="btn btn-outline-secondary" onclick="ptClearSearch()" title="清除"><i class="bi bi-x-lg"></i></button>
                </div>
            </div>
            <div class="row g-2">
                <div class="col-md-4">
                    <div class="pt-spark-box">
                        <div class="pt-spark-label"><i class="bi bi-list-ol me-1"></i>总线程</div>
                        <svg id="ptSparkThreads" class="pt-spark"></svg>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="pt-spark-box">
                        <div class="pt-spark-label"><i class="bi bi-memory me-1"></i>总工作集</div>
                        <svg id="ptSparkMem" class="pt-spark"></svg>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="pt-spark-box">
                        <div class="pt-spark-label"><i class="bi bi-key me-1"></i>总句柄</div>
                        <svg id="ptSparkHandles" class="pt-spark"></svg>
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 mt-2">
                <button class="btn btn-sm btn-outline-secondary" onclick="ptTimelinePrev()" title="上一个快照">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <span id="ptSnapshotInfo" class="text-muted small"></span>
                <button class="btn btn-sm btn-outline-secondary" onclick="ptTimelineNext()" title="下一个快照">
                    <i class="bi bi-chevron-right"></i>
                </button>
                <span id="ptDiffSummary" class="pt-diff-summary d-none ms-2"></span>
            </div>
        </div>
    </div>

    <!-- 主行: 会话列表(窄) + 力导向图(主) + 雷达图(右) -->
    <div class="row g-2" style="min-height:680px;">
        <!-- 会话列表 (窄列) -->
        <div class="col-md-2">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center py-2">
                    <span class="small"><i class="bi bi-hdd-rack me-1"></i>会话</span>
                    <button class="btn btn-outline-dark btn-sm py-0 px-1" onclick="ptLoadSessions()"><i class="bi bi-arrow-clockwise"></i></button>
                </div>
                <div class="card-body p-0" style="overflow-y:auto; max-height:680px;">
                    <div id="ptSessionList" class="list-group list-group-flush">
                        <div class="text-center text-muted py-4 small">加载中...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 进程树 (文本树, 仿 SuperUserService tree 命令) -->
        <div class="col-md-7">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center py-2 flex-wrap gap-1">
                    <span id="ptDetailTitle" class="small fw-bold"><i class="bi bi-diagram-3 me-1"></i>进程树</span>
                    <span id="ptTreeSummary" class="text-muted small"></span>
                </div>
                <div class="card-body p-0 position-relative" style="height:680px;overflow-y:auto;">
                    <!-- 文本树容器 -->
                    <div id="ptTreeText" class="pt-tree-text"></div>
                    <!-- 空状态 -->
                    <div id="ptGraphEmpty" class="position-absolute top-50 start-50 translate-middle text-center text-muted">
                        <i class="bi bi-diagram-3 display-4 d-block mb-3"></i>
                        选择左侧会话查看进程树
                    </div>
                </div>
            </div>
        </div>

        <!-- 雷达图 + 节点信息 (右侧, 没有 tab) -->
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-header py-2">
                    <span id="ptRadarTitle" class="small fw-bold"><i class="bi bi-activity me-1"></i>多维雷达</span>
                </div>
                <div class="card-body p-2 d-flex flex-column" style="height:680px;">
                    <div id="ptRadarEmpty" class="text-center text-muted py-5">
                        <i class="bi bi-cursor display-4 d-block mb-3"></i>
                        <div class="small">点击树中进程行<br>查看多维雷达</div>
                    </div>
                    <div id="ptRadarContent" class="d-none flex-grow-1" style="overflow-y:auto;">
                        <svg id="ptRadarSvg" viewBox="0 0 220 220" style="width:100%;"></svg>
                        <div id="ptNodeInfo" class="mt-2"></div>
                        <div id="ptNodeDetail" class="mt-2"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 底部: 异常进程清单 (只列安全问题, 点击跳到图中高亮) -->
    <div class="card mt-2">
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <span class="small fw-bold"><i class="bi bi-exclamation-triangle me-1"></i>异常进程清单</span>
            <span id="ptAnomalyCount" class="text-muted small"></span>
        </div>
        <div class="card-body p-2">
            <div id="ptAnomalyList" class="d-flex flex-wrap gap-2">
                <div class="text-center text-muted py-2 w-100 small">选择会话查看异常进程</div>
            </div>
        </div>
    </div>
</div>

<style>
/* ═══════════════════════════════════════════════════════════════
 *  会话列表项
 * ═══════════════════════════════════════════════════════════════ */
.pt-session-item {
    cursor: pointer;
    transition: background 0.15s;
    border-left: 3px solid transparent;
    padding: 0.4rem 0.5rem;
    font-size: 0.78rem;
}
.pt-session-item:hover { background: rgba(0,0,0,0.02); }
.pt-session-item.active {
    background: rgba(13,110,253,0.04);
    border-left-color: #0d6efd;
}
.pt-session-item .session-status {
    width: 7px; height: 7px;
    border-radius: 50%;
    display: inline-block;
    margin-right: 5px;
}
.pt-session-item .session-status.active { background: #16a34a; }
.pt-session-item .session-status.finished { background: #999; }

/* ═══════════════════════════════════════════════════════════════
 *  Sparkline 快照选择器
 * ═══════════════════════════════════════════════════════════════ */
.pt-spark-box {
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 0.25rem 0.5rem;
    background: #fff;
}
.pt-spark-label {
    font-size: 0.68rem;
    color: #666;
    margin-bottom: 0.1rem;
    font-weight: 500;
}
.pt-spark {
    width: 100%;
    height: 48px;
    display: block;
    cursor: crosshair;
}
.pt-spark .spark-click-target {
    fill: transparent;
    cursor: pointer;
}
.pt-spark .spark-click-target:hover {
    fill: rgba(13,110,253,0.06);
}
.pt-spark .spark-line {
    fill: none;
    stroke: #0d6efd;
    stroke-width: 1.5;
}
.pt-spark .spark-area {
    fill: rgba(13,110,253,0.08);
}
.pt-spark .spark-dot {
    fill: #0d6efd;
    stroke: #fff;
    stroke-width: 1;
    pointer-events: none;
}
.pt-spark .spark-dot.selected {
    fill: #dc2626;
    r: 4;
}
.pt-spark .spark-vline {
    stroke: #dc2626;
    stroke-width: 1;
    stroke-dasharray: 2,2;
    pointer-events: none;
}

.pt-diff-summary {
    font-size: 0.72rem;
    font-family: monospace;
    padding: 1px 6px;
    border-radius: 3px;
    background: rgba(13,110,253,0.08);
    color: #0d6efd;
}

/* ═══════════════════════════════════════════════════════════════
 *  文本进程树 (仿 SuperUserService tree 命令)
 * ═══════════════════════════════════════════════════════════════ */
.pt-tree-text {
    font-family: "Cascadia Mono", "Consolas", "Courier New", monospace;
    font-size: 0.74rem;
    line-height: 1.45;
    padding: 0.4rem 0.6rem;
    color: #1a1a1a;
    white-space: pre;
}
.pt-tree-text .pt-tree-row {
    cursor: pointer;
    padding: 1px 4px;
    border-radius: 2px;
    transition: background 0.1s;
    display: block;
}
.pt-tree-text .pt-tree-row:hover {
    background: rgba(13,110,253,0.06);
}
.pt-tree-text .pt-tree-row.selected {
    background: rgba(13,110,253,0.14);
    box-shadow: inset 2px 0 0 #0d6efd;
}
.pt-tree-text .pt-tree-row.diff-new {
    background: rgba(22,163,74,0.10);
}
.pt-tree-text .pt-tree-row.diff-new.selected {
    background: rgba(22,163,74,0.20);
    box-shadow: inset 2px 0 0 #16a34a;
}
.pt-tree-text .pt-tree-row.diff-removed {
    color: #dc2626;
    text-decoration: line-through;
    opacity: 0.65;
}
.pt-tree-text .pt-tree-row.diff-changed {
    background: rgba(245,158,11,0.10);
}
.pt-tree-text .pt-tree-row.diff-changed.selected {
    background: rgba(245,158,11,0.20);
    box-shadow: inset 2px 0 0 #f59e0b;
}
.pt-tree-text .pt-tree-branch {
    color: #9ca3af;
}
.pt-tree-text .pt-tree-pid {
    color: #0d6efd;
    font-weight: 600;
}
.pt-tree-text .pt-tree-name {
    color: #1a1a1a;
    font-weight: 500;
}
.pt-tree-text .pt-tree-meta {
    color: #6b7280;
}
.pt-tree-text .pt-tree-flag {
    font-weight: 700;
    margin-left: 0.4rem;
}
.pt-tree-text .pt-tree-flag.ppl { color: #dc2626; }
.pt-tree-text .pt-tree-flag.mem { color: #f59e0b; }
.pt-tree-text .pt-tree-flag.handle { color: #d97706; }
.pt-tree-text .pt-tree-flag.untrusted { color: #7c3aed; }
.pt-tree-text .pt-tree-diff-tag {
    font-size: 0.66rem;
    padding: 0 3px;
    border-radius: 2px;
    margin-left: 0.3rem;
    font-weight: 700;
}
.pt-tree-text .pt-tree-diff-tag.new { background: rgba(22,163,74,0.2); color: #16a34a; }
.pt-tree-text .pt-tree-diff-tag.removed { background: rgba(220,38,38,0.2); color: #dc2626; }
.pt-tree-text .pt-tree-diff-tag.changed { background: rgba(245,158,11,0.2); color: #d97706; }

/* ═══════════════════════════════════════════════════════════════
 *  雷达图
 * ═══════════════════════════════════════════════════════════════ */
.pt-radar {
    background: #fff;
}
.pt-radar .radar-grid {
    fill: none;
    stroke: #e5e7eb;
    stroke-width: 0.5;
}
.pt-radar .radar-axis {
    stroke: #d0d0d0;
    stroke-width: 0.5;
}
.pt-radar .radar-axis-label {
    font-size: 9px;
    fill: #666;
    text-anchor: middle;
    dominant-baseline: middle;
}
.pt-radar .radar-axis-value {
    font-size: 7px;
    fill: #999;
    text-anchor: middle;
    dominant-baseline: middle;
    font-family: monospace;
}
.pt-radar .radar-polygon {
    fill: rgba(13,110,253,0.2);
    stroke: #0d6efd;
    stroke-width: 1.5;
}
.pt-radar .radar-point {
    fill: #0d6efd;
}
.pt-radar .radar-point.critical {
    fill: #dc2626;
}

/* 节点信息 */
.pt-node-info {
    font-size: 0.76rem;
}
.pt-node-info .kv {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 0.15rem 0.4rem;
}
.pt-node-info .kv .k {
    color: #888;
    font-weight: 500;
}
.pt-node-info .kv .v {
    color: #1a1a1a;
    word-break: break-all;
}
.pt-node-info .kv .v.mono {
    font-family: monospace;
    font-size: 0.74rem;
}
.pt-node-info .flag-badges {
    margin-top: 0.4rem;
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
}
.pt-node-info .flag-badge {
    font-size: 0.66rem;
    padding: 1px 5px;
    border-radius: 3px;
    font-weight: 600;
}
.pt-node-info .flag-badge.ppl { background: rgba(220,38,38,0.15); color: #dc2626; }
.pt-node-info .flag-badge.mem { background: rgba(245,158,11,0.15); color: #d97706; }
.pt-node-info .flag-badge.handle { background: rgba(217,119,6,0.15); color: #b45309; }
.pt-node-info .flag-badge.untrusted { background: rgba(124,58,237,0.15); color: #7c3aed; }

/* ═══════════════════════════════════════════════════════════════
 *  异常清单
 * ═══════════════════════════════════════════════════════════════ */
.pt-anomaly-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    background: #fff;
    cursor: pointer;
    transition: all 0.15s;
    font-size: 0.74rem;
}
.pt-anomaly-chip:hover {
    border-color: #dc2626;
    background: rgba(220,38,38,0.04);
}
.pt-anomaly-chip .pid {
    font-family: monospace;
    font-weight: 700;
    color: #2563eb;
}
.pt-anomaly-chip .name {
    color: #1a1a1a;
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.pt-anomaly-chip .badge {
    font-size: 0.6rem;
    font-weight: 600;
}
.pt-anomaly-chip.focused {
    border-color: #dc2626;
    box-shadow: 0 0 0 2px rgba(220,38,38,0.2);
}
</style>

<script src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"></script>
<script src="/js/session-list.js" asp-append-version="true"></script>
<script src="/js/process-tree.js" asp-append-version="true"></script>
