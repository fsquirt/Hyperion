<div class="p-4">
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabBlList"><i class="bi bi-list-ul me-1"></i>驱动列表</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabBlHistory"><i class="bi bi-clock-history me-1"></i>验证历史</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabBlUpdate"><i class="bi bi-cloud-arrow-down me-1"></i>更新源</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabBlUpload"><i class="bi bi-upload me-1"></i>手动拉黑</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabBlHash"><i class="bi bi-hash me-1"></i>按哈希添加</button></li>
    </ul>

    <div class="tab-content">
        <!--  驱动列表  -->
        <div class="tab-pane fade show active" id="tabBlList">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span><i class="bi bi-list-ul me-2"></i>已拉黑驱动
                        <span class="badge badge-pass ms-2" id="blStatTotal">-</span>
                    </span>
                    <div class="d-flex align-items-center gap-2">
                        <select class="form-select form-select-sm" id="blSourceFilter" style="width:130px" onchange="loadBlList()">
                            <option value="">全部来源</option>
                            <option value="loldriver">LOLDrivers</option>
                            <option value="msft">MSFT</option>
                            <option value="manual">手动添加</option>
                        </select>
                        <div class="input-group input-group-sm" style="width:260px">
                            <input type="text" class="form-control" id="blSearch" placeholder="搜索驱动名 / 哈希..." onkeydown="if(event.key==='Enter')loadBlList()">
                            <button class="btn btn-outline-secondary" onclick="loadBlList()"><i class="bi bi-search"></i></button>
                        </div>
                        <button class="btn btn-outline-dark btn-sm" onclick="loadBlList()"><i class="bi bi-arrow-clockwise"></i></button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height:65vh;overflow:auto">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="sticky-top bg-white">
                                <tr><th>来源</th><th>驱动名</th><th>MD5</th><th>SHA1</th><th>SHA256</th><th>添加时间</th><th>操作</th></tr>
                            </thead>
                            <tbody id="blTableBody"><tr><td colspan="7" class="text-center text-muted py-4">加载中...</td></tr></tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <span class="text-muted small" id="blPageInfo">-</span>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary" id="blPrev" onclick="blChangePage(-1)"><i class="bi bi-chevron-left"></i></button>
                        <button class="btn btn-outline-secondary" id="blNext" onclick="blChangePage(1)"><i class="bi bi-chevron-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!--  验证历史  -->
        <div class="tab-pane fade" id="tabBlHistory">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="text-muted small">每次客户端上传驱动哈希校验的记录</div>
                <div class="d-flex gap-2">
                    <input type="text" class="form-control form-control-sm" style="width:250px" id="blHistorySearch" placeholder="搜索 ID / 时间 / 结果..." onkeydown="if(event.key==='Enter')filterBlHistory()">
                    <button class="btn btn-outline-secondary btn-sm" onclick="filterBlHistory()"><i class="bi bi-search"></i></button>
                    <button class="btn btn-outline-dark btn-sm" onclick="loadBlHistory()"><i class="bi bi-arrow-clockwise"></i></button>
                </div>
            </div>
            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height:65vh;overflow:auto">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="sticky-top bg-white"><tr><th>时间</th><th>校验 ID</th><th>客户端驱动</th><th>命中拉黑</th><th>结果</th></tr></thead>
                            <tbody id="blHistoryTable"><tr><td colspan="5" class="text-center text-muted py-4">加载中...</td></tr></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!--  更新源  -->
        <div class="tab-pane fade" id="tabBlUpdate">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header"><i class="bi bi-bug me-2"></i>LOLDrivers</div>
                        <div class="card-body">
                            <p class="text-muted small">从 <a href="https://www.loldrivers.io" target="_blank">loldrivers.io</a> 拉取最新漏洞驱动列表，涵盖 MD5、SHA1 与 SHA256 三种哈希。</p>
                            <div id="blLolInfo" class="mb-3 text-muted small">加载中...</div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-primary btn-sm" id="blLolBtn" onclick="updateLoldrivers(false)">
                                    <i class="bi bi-cloud-download me-1"></i>联网更新
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" onclick="updateLoldrivers(true)">
                                    <i class="bi bi-file-earmark me-1"></i>仅解析本地
                                </button>
                            </div>
                            <div id="blLolResult" class="mt-3"></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header"><i class="bi bi-shield-fill-exclamation me-2"></i>微软易受攻击驱动阻止列表</div>
                        <div class="card-body">
                            <p class="text-muted small">从 <a href="https://aka.ms/VulnerableDriverBlockList" target="_blank">aka.ms</a> 下载 zip，解压解析 <code>DriverPolicy_Enforced.xml</code>，取其中的 SHA1 与 SHA256。</p>
                            <div id="blMsftInfo" class="mb-3 text-muted small">加载中...</div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-primary btn-sm" id="blMsftBtn" onclick="updateMsft(false)">
                                    <i class="bi bi-cloud-download me-1"></i>联网更新
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" onclick="updateMsft(true)">
                                    <i class="bi bi-file-earmark me-1"></i>仅解析本地
                                </button>
                            </div>
                            <div id="blMsftResult" class="mt-3"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--  手动拉黑  -->
        <div class="tab-pane fade" id="tabBlUpload">
            <div class="card" style="max-width:640px">
                <div class="card-header"><i class="bi bi-upload me-2"></i>上传 .sys 文件手动拉黑</div>
                <div class="card-body">
                    <p class="text-muted small">上传驱动文件，后台计算 MD5/SHA1/SHA256 后加入拉黑列表，来源标记为「手动添加」。</p>
                    <div class="mb-3">
                        <label class="form-label">驱动文件 (.sys)</label>
                        <input type="file" class="form-control" id="blUploadFile" accept=".sys,.dll,.exe">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">备注，选填</label>
                        <input type="text" class="form-control" id="blUploadNotes" placeholder="如:外挂 XXX 用驱动">
                    </div>
                    <button class="btn btn-danger btn-sm" id="blUploadBtn" onclick="uploadSys()">
                        <i class="bi bi-shield-x me-1"></i>计算哈希并拉黑
                    </button>
                    <div id="blUploadResult" class="mt-3"></div>
                </div>
            </div>
        </div>

        <!--  按哈希添加  -->
        <div class="tab-pane fade" id="tabBlHash">
            <div class="card" style="max-width:640px">
                <div class="card-header"><i class="bi bi-hash me-2"></i>手动输入哈希添加拉黑</div>
                <div class="card-body">
                    <p class="text-muted small">直接填写驱动名与至少一个哈希。哈希要求：MD5 为 32 位、SHA1 为 40 位、SHA256 为 64 位，均为十六进制；无需上传文件。</p>
                    <div class="mb-3">
                        <label class="form-label">驱动名</label>
                        <input type="text" class="form-control" id="blHashName" placeholder="如: cheat.sys">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">MD5，32 位十六进制</label>
                        <input type="text" class="form-control font-monospace" id="blHashMd5" placeholder="可选,32 位十六进制">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">SHA1，40 位十六进制</label>
                        <input type="text" class="form-control font-monospace" id="blHashSha1" placeholder="可选,40 位十六进制">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">SHA256，64 位十六进制</label>
                        <input type="text" class="form-control font-monospace" id="blHashSha256" placeholder="可选,64 位十六进制">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">备注，选填</label>
                        <input type="text" class="form-control" id="blHashNotes" placeholder="如:外挂 XXX 用驱动">
                    </div>
                    <button class="btn btn-danger btn-sm" id="blHashBtn" onclick="addByHash()">
                        <i class="bi bi-plus-circle me-1"></i>添加拉黑
                    </button>
                    <div id="blHashResult" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!--  编辑模态框  -->
<div class="modal fade" id="blEditModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>编辑拉黑记录</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="blEditId">
                <div class="mb-3">
                    <label class="form-label">来源</label>
                    <div id="blEditSource"></div>
                </div>
                <div class="mb-3">
                    <label class="form-label">驱动名</label>
                    <input type="text" class="form-control" id="blEditDriverName">
                </div>
                <div class="mb-3">
                    <label class="form-label">MD5，留空表示清除</label>
                    <input type="text" class="form-control font-monospace" id="blEditMd5">
                </div>
                <div class="mb-3">
                    <label class="form-label">SHA1，留空表示清除</label>
                    <input type="text" class="form-control font-monospace" id="blEditSha1">
                </div>
                <div class="mb-3">
                    <label class="form-label">SHA256，留空表示清除</label>
                    <input type="text" class="form-control font-monospace" id="blEditSha256">
                </div>
                <div class="mb-3">
                    <label class="form-label">备注</label>
                    <input type="text" class="form-control" id="blEditNotes">
                </div>
                <div class="text-muted small">提示:至少保留一个哈希;留空字段会被清空,不会保留原值。</div>
                <div id="blEditResult" class="mt-3"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="blEditSubmit" onclick="submitEditBl()">保存</button>
            </div>
        </div>
    </div>
</div>

<!--  验证历史详情模态框  -->
<div class="modal fade" id="blHistoryDetailModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-info-circle me-2"></i>驱动验证详情</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="blHistoryDetailBody">加载中...</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">关闭</button>
            </div>
        </div>
    </div>
</div>

<script src="/js/blocklist-dashboard.js" asp-append-version="true"></script>
