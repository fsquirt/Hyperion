<div class="p-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="bi bi-image me-2 text-primary"></i>客户端背景图配置</h4>
            <div class="text-muted small">管理 UserService 启动加载窗体的背景图，支持多图管理、指定主图或随机轮播</div>
        </div>
        <div>
            <button class="btn btn-outline-secondary btn-sm" id="btn-refresh-splash">
                <i class="bi bi-arrow-clockwise me-1"></i>刷新
            </button>
        </div>
    </div>

    <!-- 策略配置卡片 -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span class="fw-bold"><i class="bi bi-gear me-2 text-primary"></i>显示模式策略</span>
            <span class="badge bg-secondary" id="splash-status-badge">加载中...</span>
        </div>
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-7">
                    <label class="form-label text-muted small">客户端启动时背景图返回逻辑：</label>
                    <div class="d-flex gap-4 mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="splashMode" id="mode-specified" value="specified" checked>
                            <label class="form-check-label" for="mode-specified">
                                <strong>指定单张图片</strong>
                                <div class="text-muted small">始终显示下方选中的固定图片</div>
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="splashMode" id="mode-random" value="random">
                            <label class="form-check-label" for="mode-random">
                                <strong>每次随机返回</strong>
                                <div class="text-muted small">每次客户端启动从图库中随机选取</div>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="col-md-5 text-md-end mt-3 mt-md-0">
                    <button class="btn btn-primary" id="btn-save-mode">
                        <i class="bi bi-check2-circle me-1"></i>保存模式配置
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 上传图片卡片 -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-bold">
            <i class="bi bi-cloud-arrow-up me-2 text-success"></i>上传新背景图
        </div>
        <div class="card-body">
            <form id="form-upload-splash" class="row g-3 align-items-center" enctype="multipart/form-data">
                <div class="col-md-8">
                    <input class="form-control" type="file" id="splashFileInput" accept=".jpg,.jpeg,.png,.webp,.bmp" required>
                    <div class="form-text text-muted">推荐使用 16:9 或 4:3 比例横屏图片，分辨率不低于 800x450，支持 JPG、PNG、WebP、BMP 格式。</div>
                </div>
                <div class="col-md-4 text-md-end">
                    <button type="submit" class="btn btn-success" id="btn-upload">
                        <i class="bi bi-upload me-1"></i>上传背景图
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 图片列表卡片 -->
    <div class="card shadow-sm">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span class="fw-bold"><i class="bi bi-images me-2 text-primary"></i>已上传背景图列表</span>
            <span class="text-muted small" id="image-count-text">共 0 张</span>
        </div>
        <div class="card-body">
            <div id="splash-gallery" class="row g-3">
                <div class="col-12 text-center text-muted py-4">加载中...</div>
            </div>
        </div>
    </div>
</div>

<script src="/js/client-splash-config.js"></script>
