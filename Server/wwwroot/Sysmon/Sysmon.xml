<Sysmon schemaversion="4.91">

  <HashAlgorithms>sha256,IMPHASH</HashAlgorithms>
  <CheckRevocation/>

  <EventFiltering>

    <!-- ═══════════════════════════════════════════════════════════════
         1. DriverLoad: 全部捕获，不排除任何厂商签名
         BYOVD (Bring Your Own Vulnerable Driver) 攻击使用的是
         合法签名但存在漏洞的驱动，排除厂商签名 = 放过攻击
         ═══════════════════════════════════════════════════════════════ -->
    <RuleGroup name="DriverLoad" groupRelation="or">
      <DriverLoad onmatch="include">
        <ImageLoaded condition="end with">.sys</ImageLoaded>
      </DriverLoad>
    </RuleGroup>

    <!-- ═══════════════════════════════════════════════════════════════
         2. CreateRemoteThread: 监控所有进程的远程线程创建
         只排除几个确定无害的系统调用者，其余全部采集
         Tracker 层做白名单和上下文关联分析
         ═══════════════════════════════════════════════════════════════ -->
    <RuleGroup name="CreateRemoteThread" groupRelation="or">
      <CreateRemoteThread onmatch="exclude">
        <!-- csrss.exe: Windows 子系统进程，正常会创建远程线程 -->
        <SourceImage condition="is">C:\Windows\System32\csrss.exe</SourceImage>
        <!-- WerFault: Windows 错误报告，调试时会创建远程线程 -->
        <SourceImage condition="is">C:\Windows\System32\WerFault.exe</SourceImage>
      </CreateRemoteThread>
    </RuleGroup>

    <!-- ═══════════════════════════════════════════════════════════════
         3. ProcessAccess: 只监控受保护进程（游戏）的句柄请求
         ProcessAccess 是超高频事件，监控所有进程会淹没在噪音里
         核心问题：谁在读/写游戏的内存？只看游戏进程就够了
         CallTrace 是 Sysmon 独有价值，Security 4656 没有此字段
         ═══════════════════════════════════════════════════════════════ -->
    <RuleGroup name="ProtectedProcessAccess" groupRelation="or">
      <ProcessAccess onmatch="include">
        <TargetImage condition="is">E:\PVZ\PlantsVsZombies.exe</TargetImage>
      </ProcessAccess>
    </RuleGroup>
    <RuleGroup name="ProtectedProcessAccessExclude" groupRelation="or">
      <ProcessAccess onmatch="exclude">
        <!-- 游戏进程自访问 -->
        <SourceImage condition="is">E:\PVZ\PlantsVsZombies.exe</SourceImage>
        <!-- 无害权限：SYNCHRONIZE / QUERY_LIMITED_INFORMATION -->
        <GrantedAccess condition="is">0x1000</GrantedAccess>
        <GrantedAccess condition="is">0x100000</GrantedAccess>
        <GrantedAccess condition="is">0x101000</GrantedAccess>
      </ProcessAccess>
    </RuleGroup>

    <!-- ═══════════════════════════════════════════════════════════════
         4. ImageLoad: 只针对受保护进程（游戏）
         高频事件，全采集性能开销太大
         重点：不排除 System32 路径！System32 里的异常 DLL 是关键证据
         ═══════════════════════════════════════════════════════════════ -->
    <RuleGroup name="ProtectedProcessImageLoad" groupRelation="or">
      <ImageLoad onmatch="include">
        <Image condition="is">E:\PVZ\PlantsVsZombies.exe</Image>
      </ImageLoad>
    </RuleGroup>

    <!-- ═══════════════════════════════════════════════════════════════
         5. ProcessTampering: 监控所有进程
         进程镂空 (Process Hollowing) 可以发生在任何进程上
         包括 explorer.exe、svchost.exe 等看起来正常的进程
         ═══════════════════════════════════════════════════════════════ -->
    <RuleGroup name="ProcessTampering" groupRelation="or">
      <ProcessTampering onmatch="include">
        <Image condition="end with">.exe</Image>
      </ProcessTampering>
    </RuleGroup>

    <!-- ═══════════════════════════════════════════════════════════════
         6. RegistryEvent: 证书存储 + 驱动服务键
         防止恶意根证书注入（绕过签名验证）和驱动持久化
         ═══════════════════════════════════════════════════════════════ -->
    <RuleGroup name="RegistryEvent" groupRelation="or">
      <RegistryEvent onmatch="include">
        <!-- 根证书/CA 证书存储：防止注入恶意根证书 -->
        <TargetObject condition="contains">SOFTWARE\Microsoft\SystemCertificates\Root\Certificates</TargetObject>
        <TargetObject condition="contains">SOFTWARE\Microsoft\SystemCertificates\CA\Certificates</TargetObject>
        <!-- 驱动服务注册：防止驱动持久化 -->
        <TargetObject condition="contains">HKLM\SYSTEM\CurrentControlSet\Services</TargetObject>
      </RegistryEvent>
    </RuleGroup>
    <RuleGroup name="RegistryEventExclude" groupRelation="or">
      <RegistryEvent onmatch="exclude">
        <!-- Windows Update 和系统服务的正常注册表操作 -->
        <Image condition="is">C:\Windows\System32\svchost.exe</Image>
      </RegistryEvent>
    </RuleGroup>

  </EventFiltering>
</Sysmon>
